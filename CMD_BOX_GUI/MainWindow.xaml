<Window x:Class="CMD_BOX_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CMD BOX GUI" 
        Height="780" Width="1100" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation -->
            <ColumnDefinition Width="220"/>
            <!-- Main Content + Terminal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR NAVIGATION ================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🛠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CMD BOX" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="WPF GUI Edition v2.0" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="28,0,0,0"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOptimizer" Content="🧹  Tối Ưu &amp; Dọn Dẹp" Style="{StaticResource SidebarNavButton}" IsChecked="True" Checked="NavButton_Checked"/>
                    <RadioButton x:Name="NavNetwork" Content="🌐  Mạng &amp; Bảo Mật" Style="{StaticResource SidebarNavButton}" Checked="NavButton_Checked"/>
                    <RadioButton x:Name="NavUtilities" Content="⚡  Tiện Ích &amp; Tự Động" Style="{StaticResource SidebarNavButton}" Checked="NavButton_Checked"/>
                    <RadioButton x:Name="NavMedia" Content="🎬  Xử Lý Media" Style="{StaticResource SidebarNavButton}" Checked="NavButton_Checked"/>
                    <RadioButton x:Name="NavGuide" Content="📖  Hướng Dẫn Dùng" Style="{StaticResource SidebarNavButton}" Checked="NavButton_Checked"/>
                </StackPanel>

                <!-- Footer Status, Admin CMD Switch & Theme Toggle (Góc dưới bên trái) -->
                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource BgCard}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="TxtAppStatus" Text="Trạng thái: Sẵn sàng" FontSize="11" Foreground="{DynamicResource AccentSuccess}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="Hotkey: ESC / F6 ngắt" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Công tắc Cho Phép / Chống Lạm Dụng Lệnh Admin CMD -->
                    <Button x:Name="BtnToggleAdminCmd" Click="BtnToggleAdminCmd_Click"
                            Style="{StaticResource SecondaryButton}" 
                            HorizontalContentAlignment="Stretch"
                            Padding="10,7" Cursor="Hand" Margin="0,0,0,6"
                            ToolTip="Bật/Tắt cơ chế cho phép thực thi trực tiếp các lệnh Admin CMD vào Realtime Log Console">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtAdminCmdIcon" Text="🛡️" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtAdminCmdLabel" Grid.Column="1" Text="Lệnh Admin: BẬT" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium"/>
                            <Border Grid.Column="2" x:Name="BrdAdminCmdSwitch" Width="30" Height="16" CornerRadius="8" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="EllAdminCmdDot" Width="10" Height="10" Fill="{DynamicResource AccentSuccess}" HorizontalAlignment="Right" Margin="2,0,2,0"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Nút Bật/Tắt Giao diện Sáng - Tối -->
                    <Button x:Name="BtnToggleTheme" Click="BtnToggleTheme_Click"
                            Style="{StaticResource SecondaryButton}" 
                            HorizontalContentAlignment="Stretch"
                            Padding="10,7" Cursor="Hand"
                            ToolTip="Chuyển đổi Giao diện Sáng / Tối (Dark / Light Mode)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtThemeLabel" Grid.Column="1" Text="Giao diện Tối" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="Medium"/>
                            <Border Grid.Column="2" x:Name="BrdThemeSwitch" Width="30" Height="16" CornerRadius="8" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="EllThemeDot" Width="10" Height="10" Fill="{DynamicResource AccentCyan}" HorizontalAlignment="Right" Margin="2,0,2,0"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT + TERMINAL LOG ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Dynamic View Host -->
                <RowDefinition Height="*"/>
                <!-- Splitter -->
                <RowDefinition Height="Auto"/>
                <!-- Terminal Console Log -->
                <RowDefinition Height="180" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- 1. Content Control chứa Views -->
            <ContentControl x:Name="MainContentHost" Grid.Row="0"/>

            <!-- 2. GridSplitter nhẹ -->
            <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"/>

            <!-- 3. Terminal Log Output -->
            <Border Grid.Row="2" Background="{DynamicResource TerminalBg}" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 REALTIME LOG CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCopyLog" Content="Copy Log" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10" Margin="0,0,6,0" Click="BtnCopyLog_Click"/>
                            <Button x:Name="BtnClearLog" Content="Xóa Log" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10" Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- TextBox Log (Đọc theo dòng, Auto-scroll) -->
                    <TextBox x:Name="TxtTerminal" Grid.Row="1" 
                             Background="Transparent" Foreground="{DynamicResource TerminalText}" 
                             BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" 
                             FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
