<Window x:Class="CMD_BOX_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CMD BOX GUI" 
        Height="800" Width="1150" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Workspace_DragOver"
        Drop="Workspace_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource BgPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. Top Horizontal Bar (VS Code / Web Dropdown Menu Bar) -->
            <RowDefinition Height="34"/>
            <!-- 1. Main Workspace (Collapsible Modules Sidebar + Multi-Tab Host + Terminal) -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Status Bar -->
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP HORIZONTAL MENU BAR (WEB DROPDOWN STYLE) ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Toggle Sidebar Button + App Brand + Dropdown Menus -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút đóng/mở gọn thanh Modules -->
                    <Button x:Name="BtnToggleSidebar" Style="{StaticResource IconToolButton}" Padding="8,4" Margin="0,0,4,0"
                            Click="BtnToggleSidebar_Click" ToolTip="Đóng / Mở thanh Modules bên trái (Ctrl+B)">
                        <TextBlock Text="☰" FontSize="13" FontWeight="Bold"/>
                    </Button>

                    <!-- Logo nhỏ gọn -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock Text="🛠️" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="CMD BOX" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Thanh Menu ngang xổ Dropdown như Web -->
                    <Menu Style="{StaticResource WebMenuBar}">
                        <!-- 1. FILE -->
                        <MenuItem Header="File" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="📂  Nhập / Mở File vào Tab..." InputGestureText="Ctrl+O" Style="{StaticResource WebSubMenuItem}" Click="MenuOpenFile_Click"/>
                            <MenuItem Header="📝  Tạo Tab Ghi Chú Nháp" InputGestureText="Ctrl+N" Style="{StaticResource WebSubMenuItem}" Click="MenuNewScratchpad_Click"/>
                            <MenuItem Header="🎬  Đưa File vào Xử Lý Media..." Style="{StaticResource WebSubMenuItem}" Click="MenuImportToMedia_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="✕   Đóng Tab Hiện Tại" InputGestureText="Ctrl+W" Style="{StaticResource WebSubMenuItem}" Click="MenuCloseCurrentTab_Click"/>
                            <MenuItem Header="🗑️  Đóng Tất Cả Tab" Style="{StaticResource WebSubMenuItem}" Click="MenuCloseAllTabs_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="🚪  Thoát Ứng Dụng" InputGestureText="Alt+F4" Style="{StaticResource WebSubMenuItem}" Click="MenuExit_Click"/>
                        </MenuItem>

                        <!-- 2. EDIT -->
                        <MenuItem Header="Edit" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="📋  Copy Nội Dung Tab File" Style="{StaticResource WebSubMenuItem}" Click="MenuCopyActiveTab_Click"/>
                            <MenuItem Header="📋  Copy Toàn Bộ Terminal Log" Style="{StaticResource WebSubMenuItem}" Click="BtnCopyLog_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="🧹  Xóa Sạch Terminal Log" Style="{StaticResource WebSubMenuItem}" Click="BtnClearLog_Click"/>
                        </MenuItem>

                        <!-- 3. VIEW -->
                        <MenuItem Header="View" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="◧   Đóng / Mở Thanh Modules" InputGestureText="Ctrl+B" Style="{StaticResource WebSubMenuItem}" Click="BtnToggleSidebar_Click"/>
                            <MenuItem Header="⬓   Ẩn / Hiện Khung Terminal" InputGestureText="Ctrl+J" Style="{StaticResource WebSubMenuItem}" Click="MenuToggleTerminal_Click"/>
                            <MenuItem Header="🗖  Phóng To / Thu Nhỏ Terminal" Style="{StaticResource WebSubMenuItem}" Click="BtnToggleTerminalHeight_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="🌓  Đổi Giao Diện Sáng / Tối" Style="{StaticResource WebSubMenuItem}" Click="BtnToggleTheme_Click"/>
                        </MenuItem>

                        <!-- 4. MODULES -->
                        <MenuItem Header="Modules" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="🧹  System Optimizer" Style="{StaticResource WebSubMenuItem}" Tag="Optimizer" Click="MenuOpenModule_Click"/>
                            <MenuItem Header="🌐  Mạng &amp; Bảo Mật" Style="{StaticResource WebSubMenuItem}" Tag="Network" Click="MenuOpenModule_Click"/>
                            <MenuItem Header="⚡  Tiện Ích &amp; Tự Động" Style="{StaticResource WebSubMenuItem}" Tag="Utilities" Click="MenuOpenModule_Click"/>
                            <MenuItem Header="🎬  Xử Lý Media" Style="{StaticResource WebSubMenuItem}" Tag="Media" Click="MenuOpenModule_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="📖  Hướng Dẫn Dùng" Style="{StaticResource WebSubMenuItem}" Tag="Guide" Click="MenuOpenModule_Click"/>
                        </MenuItem>

                        <!-- 5. TERMINAL -->
                        <MenuItem Header="Terminal" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="▶   Chạy Thử Kiểm Tra Nhanh (System Info)" Style="{StaticResource WebSubMenuItem}" Click="MenuQuickDiagCmd_Click"/>
                            <MenuItem Header="🛡️  Bật / Tắt Quyền Lệnh Admin CMD" Style="{StaticResource WebSubMenuItem}" Click="BtnToggleAdminCmd_Click"/>
                            <Separator Style="{StaticResource WebMenuSeparator}"/>
                            <MenuItem Header="🗑️  Xóa Sạch Log Console" Style="{StaticResource WebSubMenuItem}" Click="BtnClearLog_Click"/>
                        </MenuItem>

                        <!-- 6. HELP -->
                        <MenuItem Header="Help" Style="{StaticResource WebTopMenuItem}">
                            <MenuItem Header="📖  Mở Tài Liệu Hướng Dẫn" Style="{StaticResource WebSubMenuItem}" Tag="Guide" Click="MenuOpenModule_Click"/>
                            <MenuItem Header="ℹ️  Giới Thiệu CMD BOX GUI" Style="{StaticResource WebSubMenuItem}" Click="MenuAbout_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Right: Quick Import File Button + Theme Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Nhập File" Style="{StaticResource SecondaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"
                            Click="MenuOpenFile_Click" ToolTip="Chọn tệp từ máy tính để mở trong Tab mới (hoặc kéo thả tệp vào cửa sổ)"/>
                    <Button x:Name="BtnTopThemeQuick" Style="{StaticResource IconToolButton}" Padding="7,3"
                            Click="BtnToggleTheme_Click" ToolTip="Chuyển đổi Giao diện Sáng / Tối">
                        <TextBlock x:Name="TxtTopThemeIcon" Text="🌙" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1. MAIN WORKSPACE ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Navigation (Đóng / Mở linh hoạt) -->
                <ColumnDefinition x:Name="ColSidebar" Width="215"/>
                <!-- Main Content (Tabs + View Host + Terminal) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 1.1 COLLAPSIBLE SIDEBAR MODULES ================= -->
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <Grid Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tiêu đề MODULES có nút đóng/mở gọn danh sách & nút thu gọn toàn Sidebar -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nút bấm đóng/mở danh sách mục con bên trong -->
                        <Button x:Name="BtnFoldModuleList" Grid.Column="0" Style="{StaticResource IconToolButton}"
                                HorizontalContentAlignment="Left" Padding="6,4"
                                Click="BtnFoldModuleList_Click" ToolTip="Thu gọn / Mở rộng danh sách Modules">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtModulesArrow" Text="▾" FontSize="11" Width="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="MODULES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút đóng hẳn cột Sidebar cho gọn không gian -->
                        <Button Grid.Column="1" Content="«" Style="{StaticResource IconToolButton}" Padding="7,2" FontSize="12"
                                Click="BtnToggleSidebar_Click" ToolTip="Ẩn thanh Modules sang trái (Ctrl+B)"/>
                    </Grid>

                    <!-- Danh sách các Module (Có thể đóng/mở gọn) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PnlModuleItems">
                            <RadioButton x:Name="NavOptimizer" Content="🧹  System Optimizer" Style="{StaticResource SidebarNavButton}" IsChecked="True" Tag="Optimizer" Click="SidebarModule_Click"/>
                            <RadioButton x:Name="NavNetwork" Content="🌐  Mạng &amp; Bảo Mật" Style="{StaticResource SidebarNavButton}" Tag="Network" Click="SidebarModule_Click"/>
                            <RadioButton x:Name="NavUtilities" Content="⚡  Tiện Ích &amp; Tự Động" Style="{StaticResource SidebarNavButton}" Tag="Utilities" Click="SidebarModule_Click"/>
                            <RadioButton x:Name="NavMedia" Content="🎬  Xử Lý Media" Style="{StaticResource SidebarNavButton}" Tag="Media" Click="SidebarModule_Click"/>
                            <RadioButton x:Name="NavGuide" Content="📖  Hướng Dẫn Dùng" Style="{StaticResource SidebarNavButton}" Tag="Guide" Click="SidebarModule_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Status & Toggles -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border Background="{DynamicResource BgCard}" CornerRadius="3" Padding="9,7" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentSuccess}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtAppStatus" Text="Trạng thái: Sẵn sàng" FontSize="11" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Hotkey: ESC / F6 ngắt" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Công tắc Lệnh Admin CMD -->
                        <Button x:Name="BtnToggleAdminCmd" Click="BtnToggleAdminCmd_Click"
                                Style="{StaticResource SecondaryButton}" 
                                HorizontalContentAlignment="Stretch"
                                Padding="8,5" Cursor="Hand" Margin="0,0,0,4"
                                ToolTip="Bật/Tắt cho phép nâng quyền Admin (Mặc định TẮT để dùng lệnh thường)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAdminCmdIcon" Text="🔒" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtAdminCmdLabel" Grid.Column="1" Text="Lệnh Admin: TẮT" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                <Border Grid.Column="2" x:Name="BrdAdminCmdSwitch" Width="26" Height="14" CornerRadius="7" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="EllAdminCmdDot" Width="8" Height="8" Fill="{DynamicResource AccentDanger}" HorizontalAlignment="Left" Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Nút Giao diện Sáng - Tối -->
                        <Button x:Name="BtnToggleTheme" Click="BtnToggleTheme_Click"
                                Style="{StaticResource SecondaryButton}" 
                                HorizontalContentAlignment="Stretch"
                                Padding="8,5" Cursor="Hand"
                                ToolTip="Chuyển đổi Giao diện Sáng / Tối">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtThemeLabel" Grid.Column="1" Text="Giao diện Tối" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                <Border Grid.Column="2" x:Name="BrdThemeSwitch" Width="26" Height="14" CornerRadius="7" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="EllThemeDot" Width="8" Height="8" Fill="{DynamicResource AccentCyan}" HorizontalAlignment="Right" Margin="2,0,2,0"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 1.2 MULTI-TAB WORKSPACE + TERMINAL ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 0. Dynamic Tab Strip -->
                    <RowDefinition Height="34"/>
                    <!-- 1. Active Tab Content / Empty Drop Zone -->
                    <RowDefinition Height="*"/>
                    <!-- 2. GridSplitter -->
                    <RowDefinition x:Name="RowSplitter" Height="2"/>
                    <!-- 3. Terminal Console Log -->
                    <RowDefinition x:Name="RowTerminal" Height="175" MinHeight="85"/>
                </Grid.RowDefinitions>

                <!-- 0. Thanh Tab động (Mở nhiều Module + File nhập vào cùng lúc như VS Code) -->
                <Border Grid.Row="0" Background="{DynamicResource EditorTabBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl x:Name="TabStripItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="tabRoot"
                                                    Background="{DynamicResource EditorTabBg}"
                                                    BorderBrush="{DynamicResource EditorTabBorder}"
                                                    BorderThickness="0,0,1,0"
                                                    Height="33"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding ToolTipText}"
                                                    MouseLeftButtonDown="TabItem_MouseLeftButtonDown">
                                                <Grid>
                                                    <!-- Vạch sáng xanh trên đầu tab đang chọn -->
                                                    <Border x:Name="topBar" Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentCyan}" Visibility="Collapsed"/>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                                                        <TextBlock Text="{Binding Icon}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="txtTitle" Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                                        <Button Content="✕" Style="{StaticResource IconToolButton}"
                                                                Padding="5,1" Margin="6,0,0,0" FontSize="9.5"
                                                                Tag="{Binding}"
                                                                Click="BtnCloseTab_Click"
                                                                ToolTip="Đóng tab (Ctrl+W)"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=tabRoot}" Value="True">
                                                    <Setter TargetName="tabRoot" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                                    <Setter TargetName="txtTitle" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="tabRoot" Property="Background" Value="{DynamicResource EditorTabActiveBg}"/>
                                                    <Setter TargetName="topBar" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="txtTitle" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Setter TargetName="txtTitle" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Nút + tạo nhanh Tab nháp ngay cạnh danh sách Tab -->
                                <Button Content="＋" Style="{StaticResource IconToolButton}" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                        Click="MenuNewScratchpad_Click" ToolTip="Tạo Tab ghi chú nháp mới (Ctrl+N)"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action nhỏ bên phải thanh Tab -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                            <Button Content="📂 Mở File" Style="{StaticResource IconToolButton}" Padding="7,3" FontSize="11"
                                    Click="MenuOpenFile_Click" ToolTip="Nhập tệp vào Tab mới (Ctrl+O)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Khung hiển thị nội dung Tab hoặc Màn hình Kéo Thả khi đóng hết Tab -->
                <Grid Grid.Row="1" Background="{DynamicResource BgPrimary}">
                    <ContentControl x:Name="MainContentHost" Visibility="Visible"/>

                    <!-- Màn hình chào / Kéo thả File khi chưa mở Tab nào -->
                    <Border x:Name="PnlEmptyWorkspace" Visibility="Collapsed" Padding="24">
                        <Border Style="{StaticResource CardPanel}" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Không Gian Làm Việc Đa Tab" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kéo thả bất kỳ tệp nào (.txt, .bat, .ps1, .json, ảnh, video...) vào cửa sổ để mở nhanh trong Tab, hoặc chọn công cụ bên dưới:"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>

                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="📂 Nhập File (Ctrl+O)" Style="{StaticResource PrimaryButton}" Margin="4" Padding="12,6" FontSize="11.5" Click="MenuOpenFile_Click"/>
                                    <Button Content="📝 Tạo Tab Nháp" Style="{StaticResource SecondaryButton}" Margin="4" Padding="12,6" FontSize="11.5" Click="MenuNewScratchpad_Click"/>
                                    <Button Content="🧹 System Optimizer" Style="{StaticResource SecondaryButton}" Margin="4" Padding="12,6" FontSize="11.5" Tag="Optimizer" Click="SidebarModule_Click"/>
                                    <Button Content="🎬 Xử Lý Media" Style="{StaticResource SecondaryButton}" Margin="4" Padding="12,6" FontSize="11.5" Tag="Media" Click="SidebarModule_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- 2. GridSplitter -->
                <GridSplitter x:Name="TerminalSplitter" Grid.Row="2" Height="2" HorizontalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"/>

                <!-- 3. Terminal Log Output -->
                <Border x:Name="TerminalContainer" Grid.Row="3" Background="{DynamicResource TerminalBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Header Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource AccentCyan}" BorderThickness="0,0,0,2" Padding="4,4" Margin="0,0,8,0">
                                        <TextBlock Text="TERMINAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <TextBlock Text="Realtime Log Console" FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnCopyLog" Content="📋 Copy" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" Click="BtnCopyLog_Click" ToolTip="Sao chép toàn bộ log"/>
                                    <Button x:Name="BtnClearLog" Content="🗑️ Xóa" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" Click="BtnClearLog_Click" ToolTip="Xóa log"/>
                                    <Button x:Name="BtnToggleTerminalHeight" Content="🗖" Style="{StaticResource SecondaryButton}" Padding="7,2" FontSize="10.5" Margin="0,0,5,0" Click="BtnToggleTerminalHeight_Click" ToolTip="Phóng to / Thu nhỏ Terminal"/>
                                    <Button Content="✕" Style="{StaticResource IconToolButton}" Padding="6,2" FontSize="10.5" Click="MenuToggleTerminal_Click" ToolTip="Ẩn khung Terminal (Ctrl+J)"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- TextBox Log -->
                        <TextBox x:Name="TxtTerminal" Grid.Row="1" 
                                 Background="Transparent" Foreground="{DynamicResource TerminalText}" 
                                 BorderThickness="0" FontFamily="Cascadia Code, Consolas, Courier New, monospace" 
                                 FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                                 Padding="10,6"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 2. BOTTOM STATUS BAR ================= -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" TextElement.Foreground="{DynamicResource StatusBarFg}">
            <Grid Margin="8,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Status Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnToggleSidebar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0" Margin="0,0,8,0" ToolTip="Đóng / Mở thanh Modules (Ctrl+B)">
                        <TextBlock x:Name="TxtStatusSidebar" Text="◧ Modules: Mở" FontSize="11" Foreground="{DynamicResource StatusBarFg}"/>
                    </Button>

                    <Button Click="MenuToggleTerminal_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0" Margin="0,0,8,0" ToolTip="Ẩn / Hiện khung Terminal (Ctrl+J)">
                        <TextBlock x:Name="TxtStatusTerminal" Text="⬓ Terminal: Hiện" FontSize="11" Foreground="{DynamicResource StatusBarFg}"/>
                    </Button>

                    <Button Click="BtnToggleAdminCmd_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0" Margin="0,0,8,0" ToolTip="Bật / Tắt cho phép chạy quyền Admin">
                        <TextBlock x:Name="TxtStatusAdmin" Text="🔒 Admin: TẮT" FontSize="11" Foreground="{DynamicResource StatusBarFg}"/>
                    </Button>
                </StackPanel>

                <!-- Right Status Indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusTabCount" Text="1 Tab" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="UTF-8" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Click="BtnToggleTheme_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0" Margin="4,0,0,0" ToolTip="Đổi Giao diện Sáng / Tối">
                        <TextBlock x:Name="TxtStatusTheme" Text="🌙 Dark+" FontSize="11" Foreground="{DynamicResource StatusBarFg}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>