<UserControl x:Class="CMD_BOX_GUI.UI.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:CMD_BOX_GUI.Models"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="920"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="CleanupFeatureCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="CleanupBlockButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Top Navigation Sub-Tabs (Đưa hẳn lên đỉnh) -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Main Tab Content Host -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Progress & Status Feedback -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP SUB-TABS (ĐƯA HẲN LÊN ĐỈNH) ================= -->
        <!-- tab | tab2 | tab3 | tab4 -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <RadioButton x:Name="TabOptGeneral" Content="⚡ Dọn Dẹp &amp; Tinh Chỉnh" Style="{StaticResource SubTabButton}" IsChecked="True" Click="TabOpt_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabOptServices" Content="🛡️ Dịch Vụ Rác (Services)" Style="{StaticResource SubTabButton}" Click="TabOpt_Click" Margin="0,0,6,4"/>
            </WrapPanel>
        </Border>

        <!-- ================= 1. MAIN TAB CONTENT ================= -->
        <Grid Grid.Row="1">

            <!-- UI 1: DỌN DẸP RÁC Ổ ĐĨA & BỘ NHỚ ĐỆM -->
            <ScrollViewer x:Name="PnlOptGeneral" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="0,0,6,6">
                    <!-- Thanh tiêu đề & Quét lại dung lượng rác -->
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="🗑️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="DỌN DẸP Ổ ĐĨA &amp; BỘ NHỚ ĐỆM (DISK CLEANUP)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnScanJunkSizes" Content="🔍 Quét Dung Lượng Rác" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Padding="12,6" FontSize="11" Click="BtnScanJunkSizes_Click" ToolTip="Quét lại dung lượng rác thực tế ở từng phân mục"/>
                    </DockPanel>

                    <!-- Khối 1: Quick Clean -->
                    <Border Style="{StaticResource CleanupFeatureCard}">
                        <Button x:Name="BtnCleanQuick" Style="{StaticResource CleanupBlockButton}" Click="BtnCleanQuick_Click" ToolTip="Dọn nhanh %temp%, C:\Windows\Temp, WER, DirectX Shader Cache, Flush DNS &amp; Thùng rác.">
                            <DockPanel>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtSizeQuick" Text="..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Quick Clean" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Dọn nhanh %temp%, Windows Temp, WER, DirectX Shader Cache, Flush DNS &amp; Thùng rác" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Khối 2: Deep Clean PRO -->
                    <Border Style="{StaticResource CleanupFeatureCard}">
                        <Button x:Name="BtnCleanPro" Style="{StaticResource CleanupBlockButton}" Click="BtnCleanPro_Click" ToolTip="Quét sâu đa tầng: Prefetch, WinSxS, Delivery Optimization, Shader GPU, Event Logs &amp; 20+ vị trí ngầm.">
                            <DockPanel>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtSizePro" Text="..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🔥 Deep Clean PRO" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Quét sâu đa tầng: Prefetch, WinSxS, Delivery Optimization, Shader GPU, Event Logs &amp; 20+ vị trí ngầm" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Khối 3: Xóa Windows.old -->
                    <Border Style="{StaticResource CleanupFeatureCard}">
                        <Button x:Name="BtnCleanWindowsOld" Style="{StaticResource CleanupBlockButton}" Click="BtnCleanWindowsOld_Click" ToolTip="Xóa các thư mục Windows.old, $Windows.~BT sau khi nâng cấp Windows (giải phóng 15-40GB+).">
                            <DockPanel>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtSizeWindowsOld" Text="..." FontSize="11" FontWeight="SemiBold" Foreground="#F87171"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚠️ Xóa Windows.old" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Xóa các thư mục Windows.old, $Windows.~BT sau khi nâng cấp Windows (giải phóng 15–40GB+)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Khối 4: Dọn Dev Cache -->
                    <Border Style="{StaticResource CleanupFeatureCard}">
                        <Button x:Name="BtnCleanDev" Style="{StaticResource CleanupBlockButton}" Click="BtnCleanDev_Click" ToolTip="Xóa cache của NPM, Yarn, Pip, NuGet, Gradle, Cargo &amp; Composer.">
                            <DockPanel>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtSizeDev" Text="..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="💻 Dọn Dev Cache" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Xóa cache của NPM, Yarn, Pip, NuGet, Gradle, Cargo &amp; Composer" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Khối 5: Dọn Cache Trình Duyệt -->
                    <Border Style="{StaticResource CleanupFeatureCard}">
                        <Button x:Name="BtnCleanBrowser" Style="{StaticResource CleanupBlockButton}" Click="BtnCleanBrowser_Click" ToolTip="Xóa bộ nhớ đệm của 8 trình duyệt (Chrome, Edge, Brave, CocCoc, Firefox, Opera, Vivaldi, Arc).">
                            <DockPanel>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,4" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtSizeBrowser" Text="..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌐 Dọn Cache Trình Duyệt" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Xóa bộ nhớ đệm của 8 trình duyệt (Chrome, Edge, Brave, CocCoc, Firefox, Opera, Vivaldi, Arc)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- UI 2: DỊCH VỤ RÁC (SERVICES MANAGER) -->
            <Grid x:Name="PnlOptServices" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Toolbar Search & Filter -->
                            <RowDefinition Height="Auto"/>
                            <!-- DataGrid Content -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🛡️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="DANH SÁCH DỊCH VỤ TIÊU HAO RAM, CPU &amp; DISK NGẦM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <DockPanel Grid.Row="1" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBox x:Name="TxtSearchServices" Style="{StaticResource FlatTextBox}" Width="200" Padding="8,4" FontSize="11" Margin="0,0,6,0" TextChanged="TxtSearchServices_TextChanged" ToolTip="Tìm kiếm theo tên dịch vụ hoặc mô tả..."/>
                                    <ComboBox x:Name="CmbServicesRiskFilter" Width="175" Padding="6,3" FontSize="11" Margin="0,0,8,0" SelectionChanged="CmbServicesRiskFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tất Cả Mức Độ" IsSelected="True"/>
                                        <ComboBoxItem Content="🟢 An Toàn"/>
                                        <ComboBoxItem Content="🟡 Cân Nhắc"/>
                                        <ComboBoxItem Content="🟠 Ảnh Hưởng Hệ Thống"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="🔄 Quét Lại" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="10.5" Margin="0,0,6,0" Click="BtnRefreshServices_Click" ToolTip="Đọc lại trạng thái hiện tại của các dịch vụ"/>
                                    <Button x:Name="BtnDisableSafeServices" Content="⚡ Tắt An Toàn (Safe)" Style="{StaticResource SuccessButton}" Padding="11,5" FontSize="11" Margin="0,0,6,0" Click="BtnDisableSafeServices_Click" ToolTip="Chỉ tắt các dịch vụ telemetry an toàn 100%, giữ nguyên các dịch vụ Xbox và Tìm kiếm"/>
                                    <Button x:Name="BtnDisableAllSelectedServices" Content="🚀 Áp Dụng Toàn Bộ" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="11" Click="BtnDisableAllSelectedServices_Click" ToolTip="Áp dụng trạng thái mục tiêu đã chọn cho toàn bộ danh sách dịch vụ trong 1 lần chạy"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="0">
                            <DataGrid x:Name="DgServices" Style="{StaticResource FlatDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DỊCH VỤ" Binding="{Binding DisplayName}" Width="1.7*"/>
                                    <DataGridTemplateColumn Header="MỨC ĐỘ" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RiskBadgeBg}" BorderBrush="{Binding RiskBadgeBorder}" BorderThickness="1" CornerRadius="10" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RiskDisplay}" Foreground="{Binding RiskBadgeFg}" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="HIỆN TẠI" Width="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CHẾ ĐỘ ĐẶT (4 TRẠNG THÁI)" Width="165">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static models:SystemServiceItem.StartupModeOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Mode"
                                                          SelectedValue="{Binding TargetStartupMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="10.5" Padding="5,2" Height="26"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MỤC TIÊU &amp; TÁC ĐỘNG" Binding="{Binding Description}" Width="2.4*"/>
                                    <DataGridTemplateColumn Header="CHẠY LẺ" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="▶ Áp Dụng" Style="{StaticResource SecondaryButton}" Padding="7,3" FontSize="10" Click="BtnToggleSingleService_Click" Tag="{Binding}" ToolTip="Áp dụng trạng thái đã chọn riêng cho service này"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 2. PROGRESS & STATUS FEEDBACK ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" x:Name="PbOptimizer" Style="{StaticResource FlatProgressBar}" Margin="0,0,0,6" Visibility="Collapsed" Height="6"/>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtStatus" Text="Sẵn sàng thực hiện các tác vụ tối ưu." FontSize="11" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDriveFree" Text="Ổ C: Đang đọc dung lượng khả dụng..." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRefreshDrive" Content="🔄" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Click="BtnRefreshDrive_Click" ToolTip="Cập nhật lại dung lượng ổ đĩa khả dụng"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>