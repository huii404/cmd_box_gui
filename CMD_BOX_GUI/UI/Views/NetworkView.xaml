<UserControl x:Class="CMD_BOX_GUI.UI.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="920"
             Loaded="UserControl_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Top Sub-Tabs Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Main Tab Content Host -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Progress & Status Feedback -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP SUB-TABS (ĐỒNG BỘ CHUẨN OPTIMIZER) ================= -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <RadioButton x:Name="TabNetOverview" Content="📊 Tổng Quan &amp; Đổi DNS" Style="{StaticResource SubTabButton}" IsChecked="True" Click="TabNet_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabNetRepair" Content="🛠️ Sửa Lỗi &amp; Cứu Hộ" Style="{StaticResource SubTabButton}" Click="TabNet_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabNetDevices" Content="📡 Thiết Bị Mạng LAN" Style="{StaticResource SubTabButton}" Click="TabNet_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabNetWifi" Content="🔑 Mật Khẩu Wi-Fi" Style="{StaticResource SubTabButton}" Click="TabNet_Click" Margin="0,0,6,4"/>
            </WrapPanel>
        </Border>

        <!-- ================= 1. MAIN TAB CONTENT ================= -->
        <Grid Grid.Row="1">

            <!-- UI 1: TỔNG QUAN & ĐỔI DNS NHANH 1-CLICK -->
            <ScrollViewer x:Name="PnlNetOverview" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="0,0,6,0">
                    <!-- Khối Card thông tin mạng trực tiếp -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="THÔNG TIN KẾT NỐI MẠNG HIỆN TẠI" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="BtnRefreshNetInfo" Content="🔄 Làm Mới" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" HorizontalAlignment="Right" Click="BtnRefreshNetInfo_Click"/>
                            </Grid>

                            <!-- Grid 4 ô thông số mạng -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ô 1: IP Nội bộ -->
                                <Border Grid.Column="0" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="IP NỘI BỘ (LAN IPv4)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtLocalIp" Text="Đang đọc..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="TxtAdapterName" Text="Card: ..." FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ô 2: Gateway (Router) -->
                                <Border Grid.Column="1" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="GATEWAY (ROUTER)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtGateway" Text="Đang đọc..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0"/>
                                        <TextBlock Text="Trang quản trị Router" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ô 3: DNS Server -->
                                <Border Grid.Column="2" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="DNS SERVER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtDns" Text="Đang đọc..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Hệ thống phân giải tên miền" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ô 4: Public IP & Ping -->
                                <Border Grid.Column="3" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="PUBLIC IP &amp; ĐỘ TRỄ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="TxtPublicIp" Text="Đang kiểm tra..." FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentSuccess}" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TxtPingLatency" Text="Ping: -- ms" FontSize="10.5" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnTestPing" Content="⚡ Đo" Style="{StaticResource SecondaryButton}" Padding="5,1" FontSize="9.5" Click="BtnTestPing_Click" ToolTip="Đo độ trễ mạng tới Google DNS (8.8.8.8)"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Khối Đổi DNS nhanh 1-Click (DNS Changer) -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CHUYỂN ĐỔI DNS NHANH 1-CLICK (VƯỢT CHẶN &amp; TĂNG TỐC GAME)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Tự động áp dụng DNS tối ưu cho card mạng đang hoạt động mà không cần vào Control Panel thủ công:" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cloudflare DNS -->
                                <Border Grid.Column="0" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="☁️ Cloudflare 1.1.1.1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="1.1.1.1  •  1.0.0.1" FontSize="11" Foreground="{DynamicResource AccentCyan}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Nhanh nhất thế giới, bảo mật và giảm giật lag ping khi chơi game." FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <Button Content="Áp Dụng Cloudflare" Style="{StaticResource PrimaryButton}" Padding="8,5" FontSize="10.5" Click="BtnSetDnsCloudflare_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Google DNS -->
                                <Border Grid.Column="1" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Google Public DNS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="8.8.8.8  •  8.8.4.4" FontSize="11" Foreground="{DynamicResource AccentCyan}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Độ tương thích cao nhất, ổn định và khắc phục lỗi nghẽn web quốc tế." FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <Button Content="Áp Dụng Google" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="10.5" Click="BtnSetDnsGoogle_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- AdGuard DNS -->
                                <Border Grid.Column="2" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ AdGuard DNS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="94.140.14.14  •  .15.15" FontSize="11" Foreground="{DynamicResource AccentCyan}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Tự động chặn quảng cáo rác, mã độc và lừa đảo từ cấp độ phân giải mạng." FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <Button Content="Áp Dụng AdGuard" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="10.5" Click="BtnSetDnsAdGuard_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- DHCP Default -->
                                <Border Grid.Column="3" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🔄 Mặc Định (DHCP)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Tự động từ Router" FontSize="11" Foreground="{DynamicResource AccentSuccess}" Margin="0,2,0,0"/>
                                        <TextBlock Text="Khôi phục lại thiết lập DNS ban đầu được cấp phát từ nhà mạng (ISP)." FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <Button Content="Khôi Phục DHCP" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="10.5" Click="BtnSetDnsDhcp_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- UI 2: SỬA LỖI & CỨU HỘ MẠNG -->
            <ScrollViewer x:Name="PnlNetRepair" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="🛠️ CÔNG CỤ SỬA LỖI &amp; KHÔI PHỤC MẠNG TỨC THÌ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. Flush DNS -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,0,6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="1. Xóa Cache DNS (Flush DNS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Xóa bộ nhớ đệm phân giải tên miền — sửa lỗi web đổi IP hoặc không tải được trang." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnFlushDns" Grid.Column="1" Content="🧹 Chạy" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11" VerticalAlignment="Center" Click="BtnFlushDns_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 2. Release & Renew IP -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="6,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="2. Làm Mới Địa Chỉ IP (DHCP Reset)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Xin cấp lại địa chỉ IP từ Router — sửa lỗi chấm than vàng, mất kết nối LAN." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnRenewIp" Grid.Column="1" Content="🔄 Chạy" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11" VerticalAlignment="Center" Click="BtnRenewIp_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 3. Reset TCP/IP & Winsock -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="3. Đặt Lại TCP/IP &amp; Winsock Stack" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Khôi phục toàn bộ giao thức mạng về mặc định — sửa lỗi sau khi gỡ VPN/Proxy." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnResetWinsock" Grid.Column="1" Content="⚡ Chạy" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11" VerticalAlignment="Center" Click="BtnResetWinsock_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 4. Reset Windows Firewall -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="4. Khôi Phục Windows Firewall Gốc" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Xóa các rule chặn mạng rác và đưa tường lửa về thiết lập mặc định của Microsoft." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnResetFirewall" Grid.Column="1" Content="🛡️ Chạy" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11" VerticalAlignment="Center" Click="BtnResetFirewall_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Khối Khôi Phục Toàn Diện 1-Click -->
                            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 KHÔI PHỤC TOÀN DIỆN 1-CLICK (REPAIR ALL)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                        <TextBlock Text="Tự động chạy liên tục cả 4 bước sửa lỗi trên — giải pháp tối thượng khi máy tính bị mất mạng hoàn toàn." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRepairAll" Grid.Column="1" Content="🚀 Chạy Toàn Bộ" Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Click="BtnRepairAll_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- UI 3: QUÉT THIẾT BỊ MẠNG LAN / WI-FI (DATAGRID) -->
            <Grid x:Name="PnlNetDevices" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Actions Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📡" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="THIẾT BỊ ĐANG KẾT NỐI CÙNG MẠNG LAN / WI-FI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDevicesStats" Text="• Chưa quét" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnScanLan" Content="🔍 Quét Thiết Bị LAN" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnScanLan_Click"/>
                                <Button x:Name="BtnOpenRouter" Content="🌐 Mở Web Router" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="10.5" Margin="0,0,6,0" Click="BtnOpenRouter_Click" ToolTip="Mở trang quản trị của Router trên trình duyệt (192.168.1.1)"/>
                                <Button x:Name="BtnCopySelectedIp" Content="📋 Copy IP" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="10.5" Click="BtnCopySelectedIp_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid Danh sách thiết bị -->
                        <Border Grid.Row="1" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="0">
                            <Grid>
                                <DataGrid x:Name="DgLanDevices" Style="{StaticResource FlatDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ĐỊA CHỈ IP" Binding="{Binding IpAddress}" FontWeight="Bold" Width="140"/>
                                        <DataGridTextColumn Header="TÊN THIẾT BỊ / HOSTNAME" Binding="{Binding HostName}" FontWeight="SemiBold" Width="2*"/>
                                        <DataGridTextColumn Header="ĐỊA CHỈ MAC" Binding="{Binding MacAddress}" Width="150"/>
                                        <DataGridTextColumn Header="PHÂN LOẠI THIẾT BỊ" Binding="{Binding DeviceType}" Width="1.5*"/>
                                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBadgeFg}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtNoDevices" Text="Bấm '🔍 Quét Thiết Bị LAN' để tìm các thiết bị đang kết nối cùng mạng Wi-Fi." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- UI 4: MẬT KHẨU WI-FI ĐÃ LƯU (WI-FI PASSWORDS VIEWER) -->
            <Grid x:Name="PnlNetWifi" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Actions Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="🔑" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="DANH SÁCH MẬT KHẨU WI-FI ĐÃ LƯU TRÊN MÁY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TxtSearchWifi" Style="{StaticResource FlatTextBox}" Width="180" Padding="8,3" FontSize="11" TextChanged="TxtSearchWifi_TextChanged" ToolTip="Tìm kiếm theo tên Wi-Fi (SSID)..."/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnRefreshWifi" Content="🔄 Đọc Lại Danh Sách" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="10.5" Margin="0,0,6,0" Click="BtnRefreshWifi_Click"/>
                                    <Button x:Name="BtnCopyWifiPassword" Content="📋 Sao Chép Mật Khẩu" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="11" Click="BtnCopyWifiPassword_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <!-- DataGrid Danh sách Wi-Fi -->
                        <Border Grid.Row="1" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="0">
                            <Grid>
                                <DataGrid x:Name="DgWifiProfiles" Style="{StaticResource FlatDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TÊN MẠNG WI-FI (SSID)" Binding="{Binding Ssid}" FontWeight="Bold" Width="2*"/>
                                        <DataGridTemplateColumn Header="MẬT KHẨU (PASSWORD)" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PasswordDisplay}" FontWeight="Bold" Foreground="{DynamicResource AccentSuccess}" VerticalAlignment="Center" Margin="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CHUẨN BẢO MẬT" Binding="{Binding Authentication}" Width="160"/>
                                        <DataGridTemplateColumn Header="THAO TÁC" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Copy Pass" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Click="BtnCopySingleWifiPass_Click" Tag="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtNoWifi" Text="Chưa đọc danh sách Wi-Fi. Bấm '🔄 Đọc Lại Danh Sách' để xem mật khẩu." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 2. PROGRESS & STATUS FEEDBACK ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" x:Name="PbNetwork" Style="{StaticResource FlatProgressBar}" Margin="0,0,0,6" Visibility="Collapsed" Height="6"/>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtNetworkStatus" Text="Sẵn sàng thực hiện các tác vụ mạng." FontSize="11" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtNetworkSummary" Text="Card mạng: Đang đọc..." FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>