<UserControl x:Class="CMD_BOX_GUI.UI.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="960"
             Loaded="MediaView_Loaded">
    <UserControl.Resources>
        <Style x:Key="MediaFeatureCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CardPickerZone" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP SUB-TABS & 1 SHARED ACTION BAR ================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <RadioButton x:Name="TabGeneral" Content="🎞️ Video &amp; Ảnh" Style="{StaticResource SubTabButton}" IsChecked="True" Click="TabMedia_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabAudioTrim" Content="🎵 Âm Thanh &amp; Cắt Video" Style="{StaticResource SubTabButton}" Click="TabMedia_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabTools" Content="⚙️ Cấu Hình" Style="{StaticResource SubTabButton}" Click="TabMedia_Click" Margin="0,0,6,4"/>
            </WrapPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <Button x:Name="BtnRunActiveCard" Content="▶ Chạy: Nén Dung Lượng (0)" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnRunActiveCard_Click" ToolTip="Chỉ chạy 1 Card đang chọn để tiết kiệm tài nguyên"/>
                <Button x:Name="BtnClearActiveCard" Content="🗑️ Xóa Tệp" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11" Margin="0,0,6,0" Click="BtnClearActiveCard_Click" ToolTip="Xóa danh sách tệp của Card đang chọn"/>
                <Button x:Name="BtnOpenLastOutput" Content="📂 Mở Thư Mục" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11" Click="BtnOpenLastOutput_Click" ToolTip="Mở thư mục chứa kết quả gần nhất"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= 1. MAIN CARD WORKSPACE ================= -->
        <Grid Grid.Row="1">

            <!-- TAB 1: VIDEO & ẢNH (CARD TỐI GIẢN) -->
            <ScrollViewer x:Name="PnlTabGeneral" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="0,0,4,6">

                    <!-- Card 1: Nén Dung Lượng -->
                    <Border x:Name="Card_compress_media" Style="{StaticResource MediaFeatureCard}" Tag="compress_media" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="compress_media" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video/Ảnh hoặc kéo thả vào Card">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_compress_media" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🗜️ Nén Dung Lượng" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Video &amp; Ảnh • Nhấn hoặc kéo thả tệp" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Mức nén:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbCompressLevel" Width="185" Height="30" FontSize="11">
                                    <ComboBoxItem Content="Nhẹ (~85% chất lượng)"/>
                                    <ComboBoxItem Content="Cân bằng (Khuyên dùng)" IsSelected="True"/>
                                    <ComboBoxItem Content="Siêu nén (Nhỏ nhất)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Đổi Định Dạng -->
                    <Border x:Name="Card_convert_media" Style="{StaticResource MediaFeatureCard}" Tag="convert_media" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="convert_media" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video/Ảnh hoặc kéo thả vào Card">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_convert_media" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔄 Đổi Định Dạng" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtConvertModeSummary" Text="Tự động: Ảnh giữ chuẩn (HEIC ➔ JPG) • Video ➔ MP4" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="BtnOpenFormatModal" Content="🎛️ Bảng Định Dạng" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,5" FontSize="11" Click="BtnOpenFormatModal_Click" ToolTip="Mở bảng tùy chỉnh định dạng đầu ra (mặc định dùng logic tự động chuẩn)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Làm Nét Media -->
                    <Border x:Name="Card_enhance_media" Style="{StaticResource MediaFeatureCard}" Tag="enhance_media" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="enhance_media" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video/Ảnh hoặc kéo thả vào Card">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_enhance_media" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✨ Làm Nét Media" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Khử nhiễu &amp; tăng độ nét Video / Ảnh" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Cấp độ:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbEnhanceLevel" Width="185" Height="30" FontSize="11">
                                    <ComboBoxItem Content="Nhẹ (Tự nhiên)"/>
                                    <ComboBoxItem Content="Tiêu chuẩn (HD)" IsSelected="True"/>
                                    <ComboBoxItem Content="Mạnh (Sắc nét cao)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4: Xóa Metadata -->
                    <Border x:Name="Card_strip_metadata" Style="{StaticResource MediaFeatureCard}" Tag="strip_metadata" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="strip_metadata" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video/Ảnh hoặc kéo thả vào Card">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_strip_metadata" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ Xóa Metadata" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Xóa EXIF, GPS, thiết bị, ngày chụp &amp; thông tin ẩn" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Chế độ:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Width="185" Height="30" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                                    <TextBlock Text="Sạch 100% (Bảo mật)" FontSize="11" Foreground="{DynamicResource AccentSuccess}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 5: Tạo Khung EXIF Ảnh -->
                    <Border x:Name="Card_exif_frame" Style="{StaticResource MediaFeatureCard}" Tag="exif_frame" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="exif_frame" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Ảnh hoặc kéo thả vào Card">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_exif_frame" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🖼️ Tạo Khung EXIF Ảnh" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Trích xuất tên máy, ống kính, khẩu độ, tốc, ISO &amp; gắn viền nghệ thuật" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Kiểu khung:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbExifFrameStyle" Width="185" Height="30" FontSize="11">
                                    <ComboBoxItem Content="Trắng Tối Giản (Leica)" IsSelected="True"/>
                                    <ComboBoxItem Content="Đen Điện Ảnh (Dark)"/>
                                    <ComboBoxItem Content="Polaroid Cổ Điển"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: ÂM THANH & CẮT VIDEO (CARD TỐI GIẢN) -->
            <ScrollViewer x:Name="PnlTabAudioTrim" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,4,6">

                    <!-- Card 1: Tách Nhạc Từ Video -->
                    <Border x:Name="Card_extract_audio" Style="{StaticResource MediaFeatureCard}" Tag="extract_audio" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="extract_audio" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video cần tách nhạc">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_extract_audio" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎵 Tách Âm Thanh" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Trích xuất MP3 / WAV / AAC / FLAC" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Xuất ra:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbExtractAudioFormat" Width="185" Height="30" FontSize="11">
                                    <ComboBoxItem Content="mp3" IsSelected="True"/>
                                    <ComboBoxItem Content="wav"/>
                                    <ComboBoxItem Content="aac"/>
                                    <ComboBoxItem Content="flac"/>
                                    <ComboBoxItem Content="ogg"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Chỉnh Âm Lượng -->
                    <Border x:Name="Card_volume_audio" Style="{StaticResource MediaFeatureCard}" Tag="volume_audio" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="volume_audio" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Audio hoặc Video">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_volume_audio" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔊 Chỉnh Âm Lượng" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Tăng hoặc giảm độ lớn Audio / Video" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Mức âm:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbAudioVolume" Width="185" Height="30" FontSize="11">
                                    <ComboBoxItem Content="Giảm 50% (0.5x)" Tag="0.5"/>
                                    <ComboBoxItem Content="Tăng +50% (1.5x)" Tag="1.5" IsSelected="True"/>
                                    <ComboBoxItem Content="Tăng gấp đôi (2.0x)" Tag="2.0"/>
                                    <ComboBoxItem Content="Tăng cực đại (3.0x)" Tag="3.0"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Cắt Video Nhanh -->
                    <Border x:Name="Card_trim_video" Style="{StaticResource MediaFeatureCard}" Tag="trim_video" Drop="Card_Drop" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CardPickerZone}" Tag="trim_video" Click="CardPickFiles_Click" ToolTip="Nhấn để chọn Video cần cắt đoạn">
                                <DockPanel>
                                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="TxtCount_trim_video" Text="0 tệp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✂️ Cắt Video Nhanh" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Cắt đoạn tức thì không render lại" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Từ (s):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtTrimStart" Style="{StaticResource FlatTextBox}" Text="0" Width="62" Height="30" Padding="6,5" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Độ dài (s):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtTrimDuration" Style="{StaticResource FlatTextBox}" Text="15" Width="62" Height="30" Padding="6,5" FontSize="11" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: CẤU HÌNH -->
            <ScrollViewer x:Name="PnlTabTools" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,4,6">
                    <Border Style="{StaticResource MediaFeatureCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="⚙️ CẤU HÌNH ENGINE FFMPEG" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtFfmpegPathInfo" Text="Đang kiểm tra đường dẫn ffmpeg.exe..." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📂 Chọn ffmpeg.exe..." Style="{StaticResource PrimaryButton}" Padding="12,7" FontSize="11" Margin="0,0,6,0" Click="BtnBrowseFfmpeg_Click"/>
                                <Button Content="🔄 Kiểm Tra Lại" Style="{StaticResource SecondaryButton}" Padding="10,7" FontSize="11" Click="BtnRefreshFfmpeg_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MediaFeatureCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="📁 NƠI LƯU TỆP ĐẦU RA" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Mỗi tệp xử lý xong được lưu tự động vào thư mục con 'CMD_BOX_Output' ngay cạnh tệp gốc." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📂 Mở Thư Mục Kết Quả Gần Nhất" Style="{StaticResource SecondaryButton}" Padding="12,7" FontSize="11" Click="BtnOpenLastOutput_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ================= 2. PROGRESS & STATUS FEEDBACK ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" x:Name="PbBatchTotal" Style="{StaticResource FlatProgressBar}" Margin="0,0,0,6" Visibility="Collapsed" Height="6"/>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtStatus" Text="Nhấn vào Card để mở Explorer chọn tệp, sau đó bấm Chạy ngay trên Card." FontSize="11" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFfmpegStatus" Text="FFmpeg: Đang kiểm tra..." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRefreshFfmpeg" Content="🔄" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Click="BtnRefreshFfmpeg_Click" ToolTip="Kiểm tra lại trạng thái FFmpeg"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ================= 3. BẢNG TÙY CHỈNH ĐỔI ĐỊNH DẠNG (MODAL OVERLAY) ================= -->
        <Border x:Name="PnlFormatModal" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Margin="-16">
            <Border Style="{StaticResource CardPanel}" Width="470" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="10" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="🎛️ BẢNG TÙY CHỈNH ĐỔI ĐỊNH DẠNG" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="✕" Style="{StaticResource IconToolButton}" Padding="6,2" FontSize="11" DockPanel.Dock="Right" Click="BtnCloseFormatModal_Click" ToolTip="Đóng bảng"/>
                    </DockPanel>

                    <RadioButton x:Name="RbFormatAuto" Content="🤖 Tự động thông minh (Mặc định)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,4" Checked="FormatModeRadio_Changed"/>
                    <TextBlock Text="• Ảnh JPG/PNG/JPEG/WEBP: Giữ nguyên định dạng gốc&#x0a;• Ảnh HEIC/HEIF/AVIF: Chuyển về JPG bảo toàn độ nét cao&#x0a;• Video mọi loại: Chuyển về MP4 (H.264 + AAC)"
                               FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="20,0,0,12" TextWrapping="Wrap"/>

                    <RadioButton x:Name="RbFormatCustom" Content="🛠️ Tùy chỉnh định dạng thủ công" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Checked="FormatModeRadio_Changed"/>

                    <Border x:Name="PnlCustomFormatOptions" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="20,0,0,12" IsEnabled="False" Opacity="0.6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Định dạng Ảnh:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFormatTargetImage" Grid.Row="0" Grid.Column="1" Height="28" FontSize="11">
                                <ComboBoxItem Content="Tự động (Giữ chuẩn / HEIC ➔ JPG)" Tag="auto" IsSelected="True"/>
                                <ComboBoxItem Content=".jpg (Ảnh phổ biến)" Tag=".jpg"/>
                                <ComboBoxItem Content=".png (Không nén / Trong suốt)" Tag=".png"/>
                                <ComboBoxItem Content=".webp (Web nhẹ &amp; nét)" Tag=".webp"/>
                                <ComboBoxItem Content=".bmp (Ảnh thô)" Tag=".bmp"/>
                                <ComboBoxItem Content=".ico (Icon tối đa 256px)" Tag=".ico"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Định dạng Video:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFormatTargetVideo" Grid.Row="2" Grid.Column="1" Height="28" FontSize="11">
                                <ComboBoxItem Content=".mp4 (Khuyên dùng)" Tag=".mp4" IsSelected="True"/>
                                <ComboBoxItem Content=".mkv (Chất lượng cao)" Tag=".mkv"/>
                                <ComboBoxItem Content=".mov (QuickTime)" Tag=".mov"/>
                                <ComboBoxItem Content=".webm (VP9 + Opus)" Tag=".webm"/>
                                <ComboBoxItem Content=".avi (Tương thích cũ)" Tag=".avi"/>
                                <ComboBoxItem Content="Giữ nguyên định dạng gốc" Tag="keep"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Chất lượng:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFormatQuality" Grid.Row="4" Grid.Column="1" Height="28" FontSize="11">
                                <ComboBoxItem Content="Bảo toàn độ nét cao (Mặc định)" IsSelected="True"/>
                                <ComboBoxItem Content="Cân bằng (Nét &amp; gọn)"/>
                                <ComboBoxItem Content="Nhẹ dung lượng"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="🛡️ Tự động chuẩn hóa mã màu (yuv420p/yuvj420p), kích thước chẵn tránh lỗi codec và giữ nguyên Metadata gốc."
                               FontSize="10.5" Foreground="{DynamicResource AccentSuccess}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <DockPanel LastChildFill="False">
                        <Button Content="↺ Về Tự Động" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11" DockPanel.Dock="Left" Click="BtnResetFormatAuto_Click"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="BtnCloseFormatModal_Click"/>
                            <Button Content="✓ Áp Dụng" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11" FontWeight="SemiBold" Click="BtnApplyFormatModal_Click"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
