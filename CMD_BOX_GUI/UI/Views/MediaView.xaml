<UserControl x:Class="CMD_BOX_GUI.UI.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="920"
             Loaded="MediaView_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Toolbar quản lý danh sách file & FFmpeg -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Bảng DataGrid danh sách tệp -->
            <RowDefinition Height="*"/>
            <!-- 2. Khối Dropdown Tác Vụ, Cấu hình & Nút thực thi -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Toolbar Quản lý Bảng File & Chọn FFmpeg -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Các nút thêm file & chọn FFmpeg -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddFiles" Content="➕ Thêm Ảnh / Video" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="11" Click="BtnAddFiles_Click"/>
                    <Button x:Name="BtnAddFolder" Content="📁 Thêm Cả Thư Mục" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,6" FontSize="11" Click="BtnAddFolder_Click"/>
                    <Button x:Name="BtnClearTable" Content="🗑️ Xóa Hết" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,6" FontSize="11" Click="BtnClearTable_Click"/>
                    <Button x:Name="BtnBrowseFfmpeg" Content="⚙️ Chọn FFmpeg..." Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11" Click="BtnBrowseFfmpeg_Click" ToolTip="Cấu hình vị trí ffmpeg.exe (dùng cho Video, Nén file &amp; Đổi đuôi)"/>
                </StackPanel>

                <!-- Thống kê số lượng tệp -->
                <Border Grid.Column="2" Background="{DynamicResource BgInput}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTableCount" Text="0 tệp trong danh sách" FontSize="11" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Bảng DataGrid Danh Sách Media (Hỗ Trợ Kéo Thả Drag & Drop) -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0" Margin="0,0,0,10" ClipToBounds="True"
                AllowDrop="True" Drop="MediaGrid_Drop" DragOver="MediaGrid_DragOver">
            <Grid>
                <DataGrid x:Name="DgMediaFiles" Style="{StaticResource FlatDataGrid}">
                    <DataGrid.Columns>
                        <!-- Tên tệp gốc (Đã bỏ nhận diện loại/icon ở đầu theo yêu cầu) -->
                        <DataGridTemplateColumn Header="TÊN TỆP" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" 
                                               VerticalAlignment="Center" Margin="6,0" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Dung lượng gốc -->
                        <DataGridTextColumn Header="DUNG LƯỢNG GỐC" Binding="{Binding FileSizeFormatted}" Width="130"/>

                        <!-- Định dạng đích: Dropdown ComboBox trực tiếp trên từng dòng -->
                        <DataGridTemplateColumn Header="ĐỊNH DẠNG ĐÍCH" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableExtensions}"
                                              SelectedItem="{Binding TargetExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FlatComboBox}"
                                              Height="26" FontSize="11" Padding="6,1" Margin="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trạng thái / Ký hiệu riêng từng dòng -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Thao tác xóa từng dòng -->
                        <DataGridTemplateColumn Header="XÓA" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="4,1" FontSize="10" 
                                            Foreground="{DynamicResource AccentDanger}" Click="BtnRemoveItem_Click" ToolTip="Xóa khỏi danh sách"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Text hướng dẫn khi bảng trống -->
                <StackPanel x:Name="PnlEmptyNotice" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Kéo thả tệp Ảnh / Video hoặc bấm 'Thêm Ảnh / Video' vào đây" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sau đó chọn tính năng ở dropdown phía dưới" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Khối Dropdown Tác Vụ, Cấu hình & Nút Thực Thi -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="12">
            <StackPanel>
                <!-- Khối Dropdown Chọn Tính Năng & Tùy Chọn Động Kèm Theo -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nhãn Dropdown -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="CHỌN TÍNH NĂNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                       
                    </StackPanel>

                    <!-- Dropdown Sổ Ra Chọn Tính Năng -->
                    <ComboBox x:Name="CmbActionFeature" Grid.Column="1" Style="{StaticResource FlatComboBox}" Height="34" SelectionChanged="CmbActionFeature_SelectionChanged">
                        <ComboBoxItem Content="📦 Nén Tệp (Cố định ~40% dung lượng)" IsSelected="True"/>
                        <ComboBoxItem Content="🔄 Đổi Định Dạng Tệp"/>
                        <ComboBoxItem Content="✨ Làm Nét &amp; Tối Ưu (Ảnh / Video)"/>
                        <ComboBoxItem Content="🎵 Trích Xuất Âm Thanh (Video ➔ MP3/AAC/WAV)"/>
                        <ComboBoxItem Content="🔇 Tắt Tiếng Video (Stream Copy 0.1s)"/>
                        <ComboBoxItem Content="🎞️ Tạo Ảnh Động GIF (Video ➔ HD GIF)"/>
                    </ComboBox>

                    <!-- Panel Cấu Hình Động Thay Đổi Theo Tính Năng Được Chọn -->
                    <Border Grid.Column="2" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <!-- 1. Cấu hình cho NÉN FILE (Cố định 40% và ẩn cấu hình mức nén) -->
                            <StackPanel x:Name="PnlOptionCompress" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 Mức nén tự động tối ưu ~40% dung lượng (giữ nguyên độ nét cao, hạn chế vỡ hình)." FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 2. Cấu hình cho ĐỔI ĐỊNH DẠNG -->
                            <StackPanel x:Name="PnlOptionConvert" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="💡 Bạn có thể chọn định dạng đích trực tiếp trên từng dòng của bảng (Video mặc định .mp4, Ảnh mặc định .png)." FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 3. Cấu hình cho LÀM NÉT (Dropdown n mức độ) -->
                            <StackPanel x:Name="PnlOptionEnhance" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="Mức độ làm nét:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbEnhanceLevel" Style="{StaticResource FlatComboBox}" Width="330" Height="28">
                                    <ComboBoxItem Content="Mức 1: Tự nhiên (Scale 100% - Khử mờ nhẹ, mịn da)"/>
                                    <ComboBoxItem Content="Mức 2: Tiêu chuẩn (Scale 140% - CAS nét căng, chống halo)" IsSelected="True"/>
                                    <ComboBoxItem Content="Mức 3: Nổi khối cao (Scale 175% - Chi tiết vi mô + Rực rỡ)"/>
                                    <ComboBoxItem Content="Mức 4: Siêu nét Ultra 2x (Scale 200% - Phục hồi chi tiết sâu)"/>
                                </ComboBox>
                                <TextBlock Text="⚡ Thuật toán YCbCr + Super-Sampling Bicubic + CAS Anti-Halo (~0.1s)" FontSize="11" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- 4. Cấu hình cho TRÍCH XUẤT ÂM THANH -->
                            <StackPanel x:Name="PnlOptionExtractAudio" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="Định dạng âm thanh:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbAudioFormat" Style="{StaticResource FlatComboBox}" Width="260" Height="28">
                                    <ComboBoxItem Content="MP3 (320kbps - Chuẩn chất lượng cao)" IsSelected="True"/>
                                    <ComboBoxItem Content="AAC (256kbps - Chuẩn Apple Audio)"/>
                                    <ComboBoxItem Content="WAV (Lossless - Nguyên bản không nén)"/>
                                    <ComboBoxItem Content="FLAC (Lossless - Nén không mất dữ liệu)"/>
                                    <ComboBoxItem Content="M4A (High Quality Audio)"/>
                                </ComboBox>
                                <TextBlock Text="⚡ Tách nhạc nền / audio từ video cực nhanh" FontSize="11" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- 5. Cấu hình cho TẮT TIẾNG VIDEO (MUTE) -->
                            <StackPanel x:Name="PnlOptionMuteVideo" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="⚡ Chế độ Stream Copy siêu tốc (~0.1s): Giữ nguyên 100% độ nét video gốc, loại bỏ hoàn toàn âm thanh." FontSize="11" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 6. Cấu hình cho TẠO ẢNH ĐỘNG GIF (Mặc định chuẩn 480p, 12 FPS, Palettegen 256 màu) -->
                            <StackPanel x:Name="PnlOptionMakeGif" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="Bắt đầu:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtGifStart" Text="0" Width="36" Style="{StaticResource FlatTextBox}" Height="26" Padding="4,1" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Thời điểm bắt đầu cắt (giây), ví dụ: 0, 10, 65..."/>
                                <TextBlock Text="s | Độ dài:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CmbGifDuration" Style="{StaticResource FlatComboBox}" Width="150" Height="26" FontSize="11" Padding="6,1" Margin="0,0,8,0" ToolTip="Độ dài đoạn GIF cần cắt">
                                    <ComboBoxItem Content="3 giây (~1-2MB)"/>
                                    <ComboBoxItem Content="5 giây (Chuẩn meme ~2-5MB)" IsSelected="True"/>
                                    <ComboBoxItem Content="10 giây (~5-10MB)"/>
                                </ComboBox>
                                <TextBlock Text="⚡ Tự động tối ưu 480p @ 12 FPS, Two-pass Palette 256 màu" FontSize="11" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Thanh Nút Thực Thi Hàng Loạt & Thanh Tiến Trình (Đã rút gọn text nút) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnStartBatch" Grid.Column="0" Content="🚀 Bắt Đầu" Style="{StaticResource PrimaryButton}" 
                            Padding="18,9" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" Click="BtnStartBatch_Click"/>

                    <Button x:Name="BtnOpenResultFolder" Grid.Column="1" Content="📁 Thư Mục Đích" Style="{StaticResource SecondaryButton}" 
                            Padding="14,9" FontSize="12" Margin="0,0,12,0" Click="BtnOpenResultFolder_Click"/>

                    <ProgressBar x:Name="PbBatchTotal" Grid.Column="2" Style="{StaticResource FlatProgressBar}" Height="10" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>







