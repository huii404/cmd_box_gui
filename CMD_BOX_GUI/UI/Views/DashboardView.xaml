<UserControl x:Class="CMD_BOX_GUI.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. Header & AI Status Badge -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Quick Suggestion Prompt Chips -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Chat Messages Workspace -->
            <RowDefinition Height="*"/>
            <!-- 4. Input & Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnClearChat" Grid.Column="1" Content="🗑️ Làm mới / Xóa Chat" Style="{StaticResource SecondaryButton}" 
                    Padding="10,5" FontSize="11" VerticalAlignment="Center" Click="BtnClearChat_Click" ToolTip="Xóa sạch lịch sử hội thoại"/>
        </Grid>

        <!-- ================= 2. QUICK PROMPT CHIPS ================= -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="💡 GỢI Ý CÂU HỎI NHANH:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button Content="🧹 Cách dọn rác Win?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="📶 Xem pass Wi-Fi đã lưu?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="🎬 Cách nén video CRF?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="🔋 Kiểm tra độ chai pin?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="⚡ Sửa lỗi mất mạng / ping lag?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="🕵️‍♂️ Cách giấu file vào ảnh/video?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="🛠️ Sửa lỗi Windows Update?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                    <Button Content="⌨️ Phím tắt ngắt khẩn cấp?" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,4" Click="QuickPrompt_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ================= 3. KHUNG HỘI THOẠI (CHAT AREA) ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlChatMessages" Margin="0,0,6,0"/>
            </ScrollViewer>
        </Border>

        <!-- ================= 4. KHUNG NHẬP LIỆU (INPUT BAR) ================= -->
        <Border Grid.Row="3" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtChatInput" Style="{StaticResource FlatTextBox}" 
                         Background="Transparent" BorderThickness="0" Padding="8,8" FontSize="12.5"
                         KeyDown="TxtChatInput_KeyDown"
                         ToolTip="Nhập câu hỏi và nhấn Enter để gửi... (Ví dụ: dọn rác, wifi, nén video, pin...)"/>

                <Button x:Name="BtnSendMessage" Grid.Column="1" Content="🚀 Gửi" Style="{StaticResource PrimaryButton}" 
                        Padding="18,8" FontSize="12" Margin="6,0,0,0" Click="BtnSendMessage_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
