<UserControl x:Class="CMD_BOX_GUI.UI.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="920">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Top Sub-Tabs Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Main Tab Content Host -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Progress & Status Feedback -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP SUB-TABS (ĐỒNG BỘ CHUẨN DESIGN SYSTEM) ================= -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <RadioButton x:Name="TabUtilApps" Content="📦 Cài App Nhanh (Winget)" Style="{StaticResource SubTabButton}" IsChecked="True" Click="TabUtil_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabUtilAuto" Content="🎯 Tự Động Hóa (Click / Spam)" Style="{StaticResource SubTabButton}" Click="TabUtil_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabUtilHardware" Content="🔋 Pin &amp; Báo Cáo Laptop" Style="{StaticResource SubTabButton}" Click="TabUtil_Click" Margin="0,0,6,4"/>
            </WrapPanel>
        </Border>

        <!-- ================= 1. MAIN TAB CONTENT ================= -->
        <Grid Grid.Row="1">

            <!-- UI 1: CÀI ĐẶT ỨNG DỤNG NHANH QUA WINGET -->
            <ScrollViewer x:Name="PnlUtilApps" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CÀI ĐẶT ỨNG DỤNG 1-CHẠM (MICROSOFT WINGET PACKAGE MANAGER)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Tự động tải &amp; cài đặt bản mới nhất từ trang chủ chính thức, không kèm phần mềm rác" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Nhóm 1: Trình Duyệt Web & Mạng Xã Hội -->
                            <TextBlock Text="🌐 TRÌNH DUYỆT &amp; LIÊN LẠC / CHAT:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Google Chrome" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallChrome_Click"/>
                                <Button Content="Brave Browser" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallBrave_Click"/>
                                <Button Content="Mozilla Firefox" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallFirefox_Click"/>
                                <Button Content="Zalo PC" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallZalo_Click"/>
                                <Button Content="Telegram Desktop" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallTelegram_Click"/>
                                <Button Content="Discord" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallDiscord_Click"/>
                            </WrapPanel>

                            <!-- Nhóm 2: Lập Trình & Dev Tools -->
                            <TextBlock Text="💻 LẬP TRÌNH &amp; CÔNG CỤ DEV:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Visual Studio Code" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallVSCode_Click"/>
                                <Button Content="Git for Windows" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallGit_Click"/>
                                <Button Content="Node.js (LTS)" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallNode_Click"/>
                                <Button Content="Python 3" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallPython_Click"/>
                                <Button Content="Notepad++" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallNotepadPlusPlus_Click"/>
                                <Button Content="Postman" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallPostman_Click"/>
                                <Button Content="Docker Desktop" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallDocker_Click"/>
                            </WrapPanel>

                            <!-- Nhóm 3: Tiện Ích & Hệ Thống -->
                            <TextBlock Text="⚡ TIỆN ÍCH &amp; NÉN FILE / HỆ THỐNG:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="7-Zip" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstall7Zip_Click"/>
                                <Button Content="WinRAR" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallWinRAR_Click"/>
                                <Button Content="UniKey" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallUniKey_Click"/>
                                <Button Content="Everything Search" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallEverything_Click"/>
                                <Button Content="Revo Uninstaller" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallRevo_Click"/>
                            </WrapPanel>

                            <!-- Nhóm 4: Giải Trí & Media -->
                            <TextBlock Text="🎬 GIẢI TRÍ &amp; MEDIA / STREAM:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button Content="VLC Media Player" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallVLC_Click"/>
                                <Button Content="Spotify" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallSpotify_Click"/>
                                <Button Content="OBS Studio" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="11,5" FontSize="11" Click="BtnInstallOBS_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- UI 2: TỰ ĐỘNG HÓA (AUTO CLICK & SPAM TEXT) -->
            <ScrollViewer x:Name="PnlUtilAuto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2.1. Auto Clicker -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,6,0" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AUTO CLICKER (TỰ ĐỘNG NHẤP CHUỘT)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="{DynamicResource BgInput}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="ESC / F6 ngắt" FontSize="10" Foreground="{DynamicResource AccentWarning}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Hàng 1: Tọa độ X, Y + Nút Lấy vị trí -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtClickX" Grid.Column="1" Text="500" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Y:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtClickY" Grid.Column="3" Text="500" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                                <Button Grid.Column="4" x:Name="BtnGetCurrentMousePos" Content="📍 Lấy Tọa Độ (3s)" Style="{StaticResource SecondaryButton}" Height="28" Padding="8,2" FontSize="10.5" Click="BtnGetCurrentMousePos_Click" ToolTip="Bấm nút rồi rê chuột đến vị trí mong muốn trong 3 giây"/>
                            </Grid>

                            <!-- Hàng 2: Số lần + Delay -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số lần:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtClickCount" Grid.Column="1" Text="100" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Delay (ms):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtClickDelay" Grid.Column="3" Text="100" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>

                            <!-- Hàng 3: Nút Bắt đầu / Dừng -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnStartAutoClick" Content="▶ Bắt Đầu Click" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,2" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Click="BtnStartAutoClick_Click"/>
                                <Button x:Name="BtnStopAutoClick" Content="⏹ Dừng Lại" Style="{StaticResource DangerButton}" Height="28" Padding="12,2" FontSize="11" Click="BtnStopAutoClick_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2.2. Spam Text / Auto Paste -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="6,0,0,0" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SPAM TEXT &amp; AUTO PASTE DÒNG" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="{DynamicResource BgInput}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="ESC / F6 ngắt" FontSize="10" Foreground="{DynamicResource AccentWarning}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Hàng 1: Nội dung văn bản -->
                            <TextBox x:Name="TxtSpamContent" Text="Xin chào bạn!" Style="{StaticResource FlatTextBox}" Height="28" Padding="8,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,0,10" ToolTip="Nhập văn bản cần gửi lặp lại hoặc dán nhiều dòng"/>

                            <!-- Hàng 2: Số lần + Delay -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số lần:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtSpamCount" Grid.Column="1" Text="10" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                                <TextBlock Grid.Column="2" Text="Delay (ms):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtSpamDelay" Grid.Column="3" Text="200" Style="{StaticResource FlatTextBox}" Height="28" Padding="6,2" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>

                            <!-- Hàng 3: Nút Gửi / Paste dòng -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnAutoPasteLines" Content="📋 Paste Từng Dòng" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,2" FontSize="11" Margin="0,0,6,0" Click="BtnAutoPasteLines_Click" ToolTip="Tự động dán lần lượt từng dòng từ clipboard có độ trễ"/>
                                <Button x:Name="BtnStartSpam" Content="🚀 Gửi Lặp Lại" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,2" FontSize="11" FontWeight="SemiBold" Click="BtnStartSpam_Click" ToolTip="Tự động spam nội dung liên tục sau 2 giây trễ"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- UI 3: PIN & BÁO CÁO PHẦN CỨNG LAPTOP -->
            <ScrollViewer x:Name="PnlUtilHardware" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🔋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CHẨN ĐOÁN &amp; XUẤT BÁO CÁO PIN LAPTOP (BATTERY REPORT)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Đo chính xác dung lượng pin gốc khi xuất xưởng, dung lượng sạc đầy hiện tại, phần trăm chai pin &amp; số chu kỳ sạc (Cycle Count) bằng công cụ độc quyền của Windows:" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button x:Name="BtnOpenBatteryHtml" Content="📄 Xuất &amp; Mở Báo Cáo Pin (HTML)" Style="{StaticResource PrimaryButton}" Padding="14,7" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,8" Click="BtnOpenBatteryHtml_Click" ToolTip="Tự động trích xuất battery-report.html và mở trên trình duyệt"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 2. PROGRESS & STATUS FEEDBACK ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" x:Name="PbUtilities" Style="{StaticResource FlatProgressBar}" Margin="0,0,0,6" Visibility="Collapsed" Height="6"/>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtUtilStatus" Text="Sẵn sàng thực hiện các tiện ích hệ thống." FontSize="11" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="Tiện ích &amp; Tự động hóa hệ thống" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>