<UserControl x:Class="CMD_BOX_GUI.UI.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="740" d:DesignWidth="980"
             Loaded="DocumentView_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Top Navigation Sub-Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Main Tab Content -->
            <RowDefinition Height="*"/>
            <!-- 2. Bottom Progress & Status Feedback -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP SUB-TABS ================= -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <RadioButton x:Name="TabDocOcr" Content="🔍 OCR &amp; Nhận Diện Chữ Từ Ảnh" Style="{StaticResource SubTabButton}" IsChecked="True" Click="TabDoc_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabDocPdf" Content="📑 Đóng Gói PDF &amp; Trích Xuất Tệp" Style="{StaticResource SubTabButton}" Click="TabDoc_Click" Margin="0,0,6,4"/>
                <RadioButton x:Name="TabDocText" Content="🔄 Chuyển Đổi &amp; Tiện Ích Văn Bản" Style="{StaticResource SubTabButton}" Click="TabDoc_Click" Margin="0,0,6,4"/>
            </WrapPanel>
        </Border>

        <!-- ================= 1. MAIN TAB CONTENT ================= -->
        <Grid Grid.Row="1">

            <!-- ================= SUB-TAB 1: OCR ẢNH SANG TXT ================= -->
            <Grid x:Name="PnlDocOcr" Visibility="Visible" AllowDrop="True" Drop="PnlDocOcr_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar Cấu hình OCR & Chọn Ảnh -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dòng 1: Nút Thao Tác Chọn File & Ngôn Ngữ -->
                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button x:Name="BtnAddOcrImages" Content="➕ Thêm Ảnh OCR..." Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="11" Click="BtnAddOcrImages_Click" ToolTip="Hỗ trợ .png, .jpg, .jpeg, .webp, .bmp, .tiff"/>
                                <Button x:Name="BtnAddOcrFolder" Content="📁 Thêm Cả Thư Mục" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,6" FontSize="11" Click="BtnAddOcrFolder_Click"/>
                                <Button x:Name="BtnClearOcrList" Content="🗑️ Xóa Danh Sách" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="10,6" FontSize="11" Click="BtnClearOcrList_Click"/>

                                <TextBlock Text="Ngôn ngữ:" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbOcrLanguage" Width="210" Height="30" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnStartOcrBatch" Content="⚡ BẮT ĐẦU OCR" Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="11.5" FontWeight="Bold" Click="BtnStartOcrBatch_Click" ToolTip="Nhận diện chữ toàn bộ danh sách ảnh bằng Windows Native OCR Engine"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Dòng 2: Tùy Chọn Xuất File & Checkbox -->
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkExportIndividualTxt" Content="📁 Tự động xuất tệp .txt cạnh mỗi ảnh gốc" IsChecked="True" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkAutoCopyClipboard" Content="📋 Tự động sao chép kết quả vào Clipboard" IsChecked="False" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOcrCountBadge" Text="0 ảnh trong danh sách" FontSize="11" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Thân Cột Đôi: Trái (DataGrid Danh Sách) & Phải (Live Text Preview / Editor) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột Trái: Bảng Danh Sách File Ảnh -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="DgOcrFiles" Style="{StaticResource FlatDataGrid}" SelectionChanged="DgOcrFiles_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN TỆP ẢNH" Binding="{Binding FileName}" FontWeight="SemiBold" Width="170"/>
                                <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding FileSizeFormatted}" Width="85"/>
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SỐ TỪ" Binding="{Binding WordCount}" Width="65"/>
                                <DataGridTextColumn Header="SỐ KÝ TỰ" Binding="{Binding CharCount}" Width="75"/>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📂" Style="{StaticResource SecondaryButton}" Padding="5,2" FontSize="10" Margin="0,0,4,0"
                                                        Tag="{Binding}" Click="BtnOpenTxtResult_Click" ToolTip="Mở tệp .txt kết quả"/>
                                                <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="5,2" FontSize="10"
                                                        Tag="{Binding}" Click="BtnRemoveOcrItem_Click" ToolTip="Gỡ khỏi danh sách"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- GridSplitter ngăn cách giữa bảng và editor -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <!-- Cột Phải: Khung Trình Soạn Thảo / Live Text Editor -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header của Editor -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="NỘI DUNG VĂN BẢN (PREVIEW / EDIT)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEditorStats" Text="0 từ | 0 ký tự" FontSize="10.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Khung TextBox Soạn Thảo -->
                            <TextBox x:Name="TxtOcrPreview" Grid.Row="1" Style="{StaticResource FlatTextBox}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11.5"
                                     Padding="10" Margin="0,0,0,10" TextChanged="TxtOcrPreview_TextChanged"/>

                            <!-- Footer Actions của Editor -->
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                                <Button x:Name="BtnCopyOcrPreview" Content="📋 Copy Tất Cả" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,5" FontSize="11" Click="BtnCopyOcrPreview_Click"/>
                                <Button x:Name="BtnSaveOcrPreview" Content="💾 Lưu File .txt..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="11" Click="BtnSaveOcrPreview_Click"/>
                                <Button x:Name="BtnCleanOcrPreview" Content="🧹 Gọn Khoảng Trắng" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="11" Click="BtnCleanOcrPreview_Click"/>
                                <Button x:Name="BtnClearOcrPreview" Content="✕ Xóa Trắng" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Click="BtnClearOcrPreview_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= SUB-TAB 2: ĐÓNG GÓI PDF & TRÍCH XUẤT TỆP ================= -->
            <ScrollViewer x:Name="PnlDocPdf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,6,0">

                    <!-- Khối 1: Đóng Gói Danh Sách Ảnh Thành File PDF Chuẩn (Images to PDF) -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ĐÓNG GÓI DANH SÁCH ẢNH THÀNH FILE PDF (IMAGES TO PDF)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Ghép nhiều ảnh hóa đơn, tài liệu scan, hợp đồng thành 1 tệp PDF duy nhất" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="130"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Button x:Name="BtnAddPdfImages" Content="➕ Thêm Ảnh Ghép..." Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="11" Click="BtnAddPdfImages_Click"/>
                                            <Button x:Name="BtnClearPdfImages" Content="🗑️ Xóa Hết" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,5" FontSize="11" Click="BtnClearPdfImages_Click"/>
                                            <Button x:Name="BtnMovePdfImageUp" Content="⬆️ Lên" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,5" FontSize="11" Click="BtnMovePdfImageUp_Click"/>
                                            <Button x:Name="BtnMovePdfImageDown" Content="⬇️ Xuống" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Click="BtnMovePdfImageDown_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPdfImageCount" Text="0 ảnh đã chọn" FontSize="10.5" Foreground="{DynamicResource AccentCyan}" FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Danh sách các file ảnh chuẩn bị đóng gói PDF -->
                                    <ListBox x:Name="LstPdfImages" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True" Drop="LstPdfImages_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Text="🖼️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Nút Thực Thi Xuất PDF -->
                                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="Tự động căn trang và nén ảnh JPEG tối ưu dung lượng." FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnExportImagesToPdf" Content="📄 Xuất Ra File PDF..." Style="{StaticResource PrimaryButton}" Padding="16,6" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" Click="BtnExportImagesToPdf_Click"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Khối 2: Trích Xuất Văn Bản Từ File Word DOCX Sang TXT -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📝" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="TRÍCH XUẤT VĂN BẢN TỪ FILE WORD DOCX SANG TXT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Đọc toàn bộ nội dung file Word (.docx) thuần C# siêu tốc, không cần cài đặt Microsoft Office." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnExtractDocxToEditor" Content="📖 Đọc Vào Editor" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="11" Click="BtnExtractDocxToEditor_Click"/>
                                <Button x:Name="BtnExtractDocxToTxt" Content="💾 Trích Xuất Ra File .txt..." Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="11" Click="BtnExtractDocxToTxt_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Khối 3: Đóng Gói Mã Nguồn & Dự Án Cho AI (Prompt Context Packer) -->
                    <Border Style="{StaticResource CardPanel}" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📦" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ĐÓNG GÓI NGỮ CẢNH DỰ ÁN CHO AI (PROMPT CONTEXT PACKER)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Gom nhiều tệp mã nguồn (.cs, .xaml, .json, .txt, .py...) thành 1 tệp duy nhất để hỏi AI" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Chọn nhiều file mã nguồn hoặc tài liệu, hệ thống sẽ gom tất cả kèm tên file và header chuẩn để bạn nạp thẳng vào ChatGPT, Claude, Gemini hoặc DeepSeek mà không sợ thiếu ngữ cảnh."
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,10" TextWrapping="Wrap"/>

                            <WrapPanel>
                                <Button x:Name="BtnPackAiContext" Content="📦 Chọn Các File &amp; Đóng Gói Vào Editor..." Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,6" FontSize="11" Click="BtnPackAiContext_Click"/>
                                <Button x:Name="BtnPackAiContextToFile" Content="💾 Lưu Thẳng Ra File Context.txt..." Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Click="BtnPackAiContextToFile_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= SUB-TAB 3: CHUYỂN ĐỔI & TIỆN ÍCH VĂN BẢN ================= -->
            <Grid x:Name="PnlDocText" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Cột Trái: Workspace Biên Tập & Chuyển Đổi Text -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Editor -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="📄" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="KHÔNG GIAN LÀM VIỆC VĂN BẢN" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtToolStats" Text="0 dòng | 0 từ | 0 ký tự" FontSize="10.5" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Ô Nhập / Chỉnh sửa văn bản -->
                        <TextBox x:Name="TxtToolWorkspace" Grid.Row="1" Style="{StaticResource FlatTextBox}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11.5"
                                 Padding="10" Margin="0,0,0,10" TextChanged="TxtToolWorkspace_TextChanged"/>

                        <!-- Action Buttons Dưới Cùng -->
                        <DockPanel Grid.Row="2" LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnToolLoadFile" Content="📂 Mở File Text..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="11" Click="BtnToolLoadFile_Click"/>
                                <Button x:Name="BtnToolSaveFile" Content="💾 Lưu Tệp..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5" FontSize="11" Click="BtnToolSaveFile_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="BtnToolCopy" Content="📋 Copy Tất Cả" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="12,5" FontSize="11" Click="BtnToolCopy_Click"/>
                                <Button x:Name="BtnToolClear" Content="✕ Xóa Trắng" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Click="BtnToolClear_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Cột Phải: Bảng Điều Khiển Các Tiện Ích Văn Bản 1-Click -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Khối 1: Sửa Lỗi Font Tiếng Việt & Dấu -->
                        <Border Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🇻🇳 SỬA LỖI FONT TIẾNG VIỆT &amp; DẤU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,6"/>
                                <TextBlock Text="Cứu tinh cho văn bản cũ bị lỗi font hiển thị ký tự lạ." FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="BtnFixTcvn3" Content="TCVN3 ➔ Unicode" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Padding="10,6" FontSize="10.5" Click="BtnFixTcvn3_Click" ToolTip="Chuyển mã font .VnTimes, .VnArial sang Unicode chuẩn"/>
                                    <Button x:Name="BtnFixVni" Content="VNI ➔ Unicode" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,6" FontSize="10.5" Click="BtnFixVni_Click" ToolTip="Chuyển mã font VNI-Windows sang Unicode chuẩn"/>
                                    <Button x:Name="BtnStripAccents" Content="Bỏ Dấu Tiếng Việt" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,6" FontSize="10.5" Click="BtnStripAccents_Click" ToolTip="Chuyển sang tiếng Việt không dấu (thuận tiện đặt tên file, slug web)"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Khối 2: Biến Đổi Kiểu Chữ (Case Converter) -->
                        <Border Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔤 BIẾN ĐỔI KIỂU CHỮ (CASE)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="IN HOA" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="UPPER" Click="BtnCaseConvert_Click"/>
                                    <Button Content="in thường" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="lower" Click="BtnCaseConvert_Click"/>
                                    <Button Content="Title Case" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="Title" Click="BtnCaseConvert_Click"/>
                                    <Button Content="camelCase" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="camelCase" Click="BtnCaseConvert_Click"/>
                                    <Button Content="snake_case" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="snake_case" Click="BtnCaseConvert_Click"/>
                                    <Button Content="kebab-case" Style="{StaticResource SecondaryButton}" Margin="0,0,4,6" Padding="8,5" FontSize="10.5" Tag="kebab-case" Click="BtnCaseConvert_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Khối 3: Làm Sạch Dữ Liệu & Lọc Trùng -->
                        <Border Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🧹 LÀM SẠCH DỮ LIỆU &amp; LỌC TRÙNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkCleanEmptyLines" Content="Xóa các dòng trống" IsChecked="True" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkCleanTrim" Content="Cắt khoảng trắng thừa đầu/cuối dòng" IsChecked="True" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkCleanDeduplicate" Content="Lọc bỏ dòng trùng lặp (Deduplicate)" IsChecked="False" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkCleanSort" Content="Sắp xếp dòng (A-Z)" IsChecked="False" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button x:Name="BtnApplyCleaning" Content="🧹 Thực Hiện Làm Sạch" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="11" Click="BtnApplyCleaning_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Khối 4: Bộ Trích Xuất Dữ Liệu Thông Minh -->
                        <Border Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔍 BỘ TRÍCH XUẤT DỮ LIỆU THÔNG MINH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="BtnExtractEmails" Content="📧 Trích Emails" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" FontSize="10.5" Click="BtnExtractEmails_Click"/>
                                    <Button x:Name="BtnExtractUrls" Content="🌐 Trích Links/URL" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" FontSize="10.5" Click="BtnExtractUrls_Click"/>
                                    <Button x:Name="BtnExtractPhones" Content="📞 Trích Số ĐT" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" FontSize="10.5" Click="BtnExtractPhones_Click"/>
                                    <Button x:Name="BtnExtractIps" Content="💻 Trích Địa Chỉ IP" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" FontSize="10.5" Click="BtnExtractIps_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Khối 5: Mã Hóa & Kiểm Tra Toàn Vẹn -->
                        <Border Style="{StaticResource CardPanel}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🔐 MÃ HÓA &amp; KIỂM TRA TOÀN VẸN (HASH)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnBase64Encode" Content="Base64 Encode" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="9,5" FontSize="10" Click="BtnBase64Encode_Click"/>
                                    <Button x:Name="BtnBase64Decode" Content="Base64 Decode" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="9,5" FontSize="10" Click="BtnBase64Decode_Click"/>
                                    <Button x:Name="BtnUrlEncode" Content="URL Encode" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="9,5" FontSize="10" Click="BtnUrlEncode_Click"/>
                                    <Button x:Name="BtnUrlDecode" Content="URL Decode" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="9,5" FontSize="10" Click="BtnUrlDecode_Click"/>
                                </WrapPanel>
                                <Button x:Name="BtnComputeFileHash" Content="🔑 Tính Mã Băm Tệp (SHA256/MD5)..." Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="10.5" Click="BtnComputeFileHash_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- ================= 2. PROGRESS & STATUS FEEDBACK ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" x:Name="PbDocTotal" Style="{StaticResource FlatProgressBar}" Margin="0,0,0,6" Visibility="Collapsed" Height="6"/>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtStatus" Text="Sẵn sàng nhận diện OCR và xử lý tài liệu." FontSize="11" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEngineStatus" Text="OCR: Windows Native Engine Sẵn Sàng" FontSize="11" Foreground="{DynamicResource AccentSuccess}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
