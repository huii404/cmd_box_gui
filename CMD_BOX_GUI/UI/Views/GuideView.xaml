<UserControl x:Class="CMD_BOX_GUI.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="880">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header & Search -->
            <RowDefinition Height="Auto"/>
            <!-- Category Chips + Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Expandable Knowledge Base Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER & SEARCH BAR ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📚 CẨM NANG &amp; HƯỚNG DẪN SỬ DỤNG HỆ THỐNG" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Tra cứu tính năng, mẹo tối ưu, cơ chế hoạt động và xử lý sự cố trong CMD BOX GUI." FontSize="11" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <!-- Search Input Box -->
            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBox x:Name="TxtSearchGuide" Grid.Column="1" Style="{StaticResource FlatTextBox}" 
                             Background="Transparent" BorderThickness="0" Padding="2,4" FontSize="12"
                             TextChanged="TxtSearchGuide_TextChanged"
                             ToolTip="Nhập từ khóa để lọc các mục hướng dẫn (ví dụ: ram, pin, wifi, h264, phím tắt...)"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" 
                            Padding="5,1" FontSize="10" Visibility="Collapsed" Click="BtnClearSearch_Click" ToolTip="Xóa tìm kiếm"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 2. CATEGORY CHIPS & ACTIONS ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Category Filter RadioButtons -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Content="Tất Cả" Style="{StaticResource SubTabButton}" IsChecked="True" Checked="FilterChip_Checked" Tag="ALL" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterDashboard" Content="🤖 Trợ Lý AI Local" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="DASHBOARD" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterOptimizer" Content="🧹 Tối Ưu" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="OPTIMIZER" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterNetwork" Content="🌐 Mạng &amp; Wi-Fi" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="NETWORK" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterUtilities" Content="⚡ Tiện Ích" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="UTILITIES" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterMedia" Content="🎬 Media &amp; Stego" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="MEDIA" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterHotkeys" Content="⌨️ Phím Tắt" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="HOTKEYS" Margin="0,0,6,4"/>
            </WrapPanel>

            <!-- Expand / Collapse All Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnExpandAll" Content="📖 Mở Hết" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnExpandAll_Click" ToolTip="Mở toàn bộ nội dung hướng dẫn"/>
                <Button x:Name="BtnCollapseAll" Content="📕 Thu Gọn" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="BtnCollapseAll_Click" ToolTip="Thu gọn tất cả"/>
            </StackPanel>
        </Grid>

        <!-- ================= 3. EXPANDABLE KNOWLEDGE BASE ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GuideContainer" Margin="0,0,8,0">

                <!-- MỤC 1: TỔNG QUAN HỆ THỐNG -->
                <Expander x:Name="CardDashboard" Style="{StaticResource ModernExpander}" Tag="DASHBOARD RAM CPU PIN DISK O DIA TONG QUAN UPTIME NET INTERNET" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="1. Giám Sát Tài Nguyên &amp; Thông Số Hệ Thống (Dashboard)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Giám sát RAM &amp; CPU thời gian thực:" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Hiển thị dung lượng RAM đang sử dụng, RAM khả dụng, phần trăm tiêu thụ cùng thông số CPU (số nhân, luồng, kiến trúc x64/ARM64) với thanh tiến trình trực quan." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Giám sát Ổ đĩa lưu trữ:" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động liệt kê tất cả các ổ đĩa logic (C:, D:, USB, ổ cứng di động), hiển thị dung lượng trống/tổng, phân loại ổ đĩa (Fixed, Removable, Network) và tỷ lệ đầy." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Tình trạng Nguồn &amp; Uptime máy tính:" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Báo cáo trạng thái cắm sạc (AC Online / Battery), phần trăm pin còn lại và thời gian máy tính đã chạy liên tục kể từ lần khởi động gần nhất." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Thông tin Mạng &amp; Quyền Administrator:" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Nhận diện card mạng chính, IPv4 cục bộ, địa chỉ MAC vật lý, Gateway và kiểm tra quyền Admin hiện tại của ứng dụng." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 2: TỐI ƯU & BẢO TRÌ -->
                <Expander x:Name="CardOptimizer" Style="{StaticResource ModernExpander}" Tag="OPTIMIZER DON RAC TEMP PREFETCH CACHE DEV STARTUP TELEMETRY WINDOWS UPDATE SUALOI">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="2. Tối Ưu Hóa, Dọn Rác &amp; Bảo Trì Windows (Optimizer)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Xóa rác nhanh (Quick Clean):" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động xóa các file tạm trong thư mục %temp%, C:\Windows\Temp và Prefetch mà người dùng thông thường khó dọn thủ công. An toàn 100%, không ảnh hưởng dữ liệu cá nhân." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Xóa rác PRO (Deep Clean):" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Dọn dẹp chuyên sâu: Windows Error Reporting, Crash Dumps, Downloaded Installations, Thumbnail Cache và bộ nhớ đệm hệ thống tích tụ lâu ngày." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Dọn Cache Lập trình viên &amp; Trình duyệt:" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Giải phóng hàng GB dung lượng từ cache npm, pip, nuget, .gradle, node-gyp cũng như cache tạm của Chrome, Edge, Brave, Cốc Cốc." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Tinh chỉnh Startup &amp; Tắt dịch vụ ngầm (Telemetry/Xbox):" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tắt bớt ứng dụng tự khởi động cùng Windows (chỉ giữ lại danh sách thiết yếu) và ngắt các dịch vụ thu thập dữ liệu ngầm (Telemetry) giúp máy chạy nhẹ, giảm nghẽn RAM/CPU." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Sửa lỗi Windows Update:" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động dừng và đặt lại các service wuauserv, cryptSvc, bits, msiserver, đổi tên thư mục SoftwareDistribution khi Windows bị kẹt cập nhật hoặc báo mã lỗi 0x800..." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 3: MẠNG & BẢO MẬT -->
                <Expander x:Name="CardNetwork" Style="{StaticResource ModernExpander}" Tag="NETWORK MANG WIFI MAT KHAU SECURITY KHIEN KHOI PHUC DNS FLUSH HOSTS IP">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3. Quản Trị Mạng, Khôi Phục Kết Nối &amp; Mật Khẩu Wi-Fi (Network)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Khôi phục Mạng PRO (8 Bước Tự Động):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Giải pháp xử lý triệt để khi mất mạng, chấm than vàng hoặc lỗi DNS: Xóa bộ nhớ đệm DNS (Flush DNS) -> Giải phóng &amp; Cấp lại IP (Release/Renew) -> Reset Winsock -> Reset TCP/IP Stack -> Khởi động lại Adapter mạng." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Quét &amp; Sao Chép Mật Khẩu Wi-Fi Đã Lưu:" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Bấm nút 'Quét Wi-Fi' để liệt kê toàn bộ mạng Wi-Fi máy từng kết nối cùng mật khẩu dạng rõ. Bạn có thể nhấn 'Copy' trên từng dòng để chia sẻ ngay cho điện thoại hoặc máy khác." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Kích hoạt Lá chắn bảo mật &amp; Kiểm tra file Hosts:" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Bật cấu hình chặn cổng SMB nguy hiểm (chống ransomware WannaCry/EternalBlue), bật tường lửa và kiểm tra nhanh tệp tin hosts xem có bị mã độc chuyển hướng website hay không." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 4: TIỆN ÍCH & TỰ ĐỘNG -->
                <Expander x:Name="CardUtilities" Style="{StaticResource ModernExpander}" Tag="UTILITIES AUTO CLICK SPAM TEXT PIN LAPTOP BATTERY BLOATWARE CAI APP 7ZIP VSCODE">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="4. Công Cụ Tự Động Hóa &amp; Tiện Ích Đa Năng (Utilities)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Auto Clicker (Click Chuột Tự Động):" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cho phép cấu hình tọa độ X, Y chính xác, số lần click và khoảng cách độ trễ (delay ms). Hỗ trợ nút 'Lấy vị trí chuột (Sau 3s)' để bạn rê chuột đến vị trí mong muốn mà không cần nhớ số tọa độ." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Spam Text &amp; Tự Động Paste Hàng Loạt:" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động nhập nội dung văn bản liên tục hoặc paste từng dòng danh sách có độ trễ, phục vụ nhập liệu tự động trong công việc. Bấm ESC hoặc F6 để ngắt ngay lập tức." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Chẩn đoán Sức Khỏe Pin Laptop &amp; Chu Kỳ Sạc:" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Đo chính xác dung lượng pin gốc (Design Capacity), dung lượng thực tế tối đa (Full Charge Capacity), phần trăm chai pin và số lần cắm sạc (Cycle Count). Có thể bấm 'Báo cáo HTML' để xem biểu đồ chi tiết từ Windows." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Gỡ Bloatware &amp; Cài App Tốc Độ Cao:" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gỡ bỏ các ứng dụng rác mặc định của Windows (Candy Crush, Xbox thừa, Cortana, Feedback Hub...) và cài đặt một chạm Chrome, VS Code, Git, 7-Zip qua Winget chuẩn Microsoft." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 5: TRUNG TÂM MEDIA & STEGANOGRAPHY -->
                <Expander x:Name="CardMedia" Style="{StaticResource ModernExpander}" Tag="MEDIA FFMPEG VIDEO NEN H264 MP3 MP4 SPEED GIF RESIZE TRIM STEGANOGRAPHY GIAU FILE">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="5. Trung Tâm Xử Lý Video Hàng Loạt &amp; Bảo Mật Steganography (Media)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Biên tập Video Hàng Loạt (Batch Processing):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Thêm từng file video hoặc thêm toàn bộ thư mục chỉ với 1 cú click. Bảng danh sách hiển thị chi tiết tên file, dung lượng, định dạng và trạng thái xử lý thời gian thực." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Các chế độ biên tập hỗ trợ (10+ Chế độ):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="1. Nén Video H.264 (CRF 22 - 30, giảm dung lượng tới 80% mà vẫn giữ độ nét).&#x0a;2. Làm nét &amp; Khử nhiễu video bằng bộ lọc unsharp / hqdn3d.&#x0a;3. Trích xuất âm thanh sang MP3 (128 - 320 kbps).&#x0a;4. Thay đổi tốc độ video (0.5x - 2.0x).&#x0a;5. Chuyển đổi định dạng (.mp4, .mkv, .avi, .webm, .mov, .mp3, .wav).&#x0a;6. Tắt / Xóa âm thanh (Mute Video).&#x0a;7. Tạo ảnh GIF động với độ phân giải tùy chỉnh.&#x0a;8. Chụp Thumbnail tại giây chỉ định.&#x0a;9. Đổi độ phân giải (4K, Full HD 1080p, HD 720p, 480p).&#x0a;10. Cắt đoạn Video (Trim) theo mốc thời gian bắt đầu và kết thúc." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Giấu File Bí Mật vào Media (Steganography Encryption):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Đóng gói tệp tài liệu bí mật (ZIP, RAR, TXT, EXE...) gắn vào đuôi tệp video/ảnh. Tệp vỏ bọc vẫn xem hoặc phát bình thường như không có gì. Khi cần, dùng chức năng 'Trích xuất File Ẩn' để phục hồi lại dữ liệu nguyên bản." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Chuẩn hóa Tên Tệp Media:" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động đổi tên toàn bộ tệp trong thư mục: loại bỏ khoảng trắng thừa, xóa ký tự đặc biệt, sửa lỗi dấu tiếng Việt giúp file tương thích tuyệt đối trên Linux, Web Server và phần mềm dựng phim." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 6: PHÍM TẮT & THAO TÁC TIỆN ÍCH -->
                <Expander x:Name="CardHotkeys" Style="{StaticResource ModernExpander}" Tag="HOTKEYS PHIM TAT ESC F6 TERMINAL LOG CONSOLE THEME DARK LIGHT SANG TOI">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌨️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="6. Phím Tắt Khẩn Cấp, Console Log &amp; Đổi Giao Diện Sáng/Tối" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Phím tắt Ngắt Khẩn Cấp (ESC hoặc F6):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Trong quá trình Auto Click, Spam Text hoặc render FFmpeg hàng loạt, bạn có thể nhấn phím ESC hoặc F6 bất kỳ lúc nào để hủy tác vụ ngay lập tức, ngăn ngừa thao tác nhầm lẫn." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Console Log Thời Gian Thực (Realtime Terminal):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Khung log phía dưới ghi lại chi tiết từng dòng lệnh CMD, kết quả thực thi và thông báo lỗi. Bạn có thể kéo thả thanh Splitter để tăng giảm chiều cao khung log, bấm 'Copy Log' để lấy toàn bộ log vào clipboard hoặc 'Xóa Log' khi cần dọn sạch." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Đổi Giao Diện Sáng / Tối (Light / Dark Mode):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Bấm nút chuyển đổi ở góc dưới bên trái Sidebar (có icon 🌙 / ☀️). Hệ thống sẽ chuyển đổi toàn bộ bảng màu của ứng dụng và khung log theo thời gian thực mà không làm gián đoạn tác vụ đang thực hiện." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- THÔNG BÁO KHI TÌM KIẾM KHÔNG RA KẾT QUẢ -->
                <Border x:Name="PnlNoResults" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Không tìm thấy mục hướng dẫn phù hợp" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hãy thử tìm bằng từ khóa khác hoặc bấm nút 'Tất Cả' để hiển thị lại toàn bộ tài liệu." FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
