<UserControl x:Class="CMD_BOX_GUI.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="880">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header & Search -->
            <RowDefinition Height="Auto"/>
            <!-- Category Chips + Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Expandable Knowledge Base Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER & SEARCH BAR ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Search Input Box -->
            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBox x:Name="TxtSearchGuide" Grid.Column="1" Style="{StaticResource FlatTextBox}" 
                             Background="Transparent" BorderThickness="0" Padding="2,4" FontSize="12"
                             TextChanged="TxtSearchGuide_TextChanged"
                             ToolTip="Nhập từ khóa để lọc các mục hướng dẫn (ví dụ: ram, pin, wifi, h264, phím tắt...)"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" 
                            Padding="5,1" FontSize="10" Visibility="Collapsed" Click="BtnClearSearch_Click" ToolTip="Xóa tìm kiếm"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 2. CATEGORY CHIPS & ACTIONS ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Category Filter RadioButtons -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <RadioButton x:Name="FilterAll" Content="Tất Cả" Style="{StaticResource SubTabButton}" IsChecked="True" Checked="FilterChip_Checked" Tag="ALL" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterOptimizer" Content="🧹 Tối Ưu" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="OPTIMIZER" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterNetwork" Content="🌐 Mạng &amp; Wi-Fi" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="NETWORK" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterUtilities" Content="⚡ Tiện Ích" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="UTILITIES" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterMedia" Content="🎬 Media" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="MEDIA" Margin="0,0,6,4"/>
                <RadioButton x:Name="FilterHotkeys" Content="⌨️ Phím Tắt" Style="{StaticResource SubTabButton}" Checked="FilterChip_Checked" Tag="HOTKEYS" Margin="0,0,6,4"/>
            </WrapPanel>

            <!-- Expand / Collapse All Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnExpandAll" Content="📖 Mở Hết" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnExpandAll_Click" ToolTip="Mở toàn bộ nội dung hướng dẫn"/>
                <Button x:Name="BtnCollapseAll" Content="📕 Thu Gọn" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="BtnCollapseAll_Click" ToolTip="Thu gọn tất cả"/>
            </StackPanel>
        </Grid>

        <!-- ================= 3. EXPANDABLE KNOWLEDGE BASE ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GuideContainer" Margin="0,0,8,0">

                <!-- MỤC 2: TỐI ƯU & BẢO TRÌ -->
                <Expander x:Name="CardOptimizer" Style="{StaticResource ModernExpander}" Tag="OPTIMIZER DON RAC TEMP PREFETCH CACHE DEV STARTUP TELEMETRY WINDOWS UPDATE SUALOI">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="2. Hệ Thống Tối Ưu &amp; Dọn Rác Windows (System Optimizer)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Master Make Win (1-Click Tinh Chỉnh Toàn Diện):" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Chuỗi tự động hóa N-trong-1: Tự động kiểm tra &amp; tắt BitLocker khôi phục tốc độ SSD, gỡ tận gốc gói WebExperience (Widgets ngầm), tắt Search/Copilot trên Taskbar, tắt tìm kiếm Bing Online, xóa lịch sử Recent Files chống soi, khôi phục Menu chuột phải Win 10, tăng tuổi thọ SSD (tắt Last Access Timestamp), tắt tiếng bíp lỗi hệ thống, kích hoạt Storage Sense dọn file tạm, bỏ qua màn hình Welcome sau Update, chặn Windows tự Reboot khi Update, tắt chớp đen UAC, tắt cảnh báo đầy ổ đĩa, gỡ sạch 15+ ứng dụng rác UWP (Cortana, Solitaire, 3D Builder, Maps...), tắt toàn bộ Services Telemetry &amp; Game thừa (chừa lại quay màn hình BcastDVR), tối ưu phản hồi 0ms và tự động khởi động lại Explorer ngay lập tức." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Quick Clean (Xóa rác nhanh):" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động dọn sạch thư mục %temp%, C:\Windows\Temp, Recent, WER Temp, DirectX Shader Cache, làm sạch Thùng rác và Flush DNS." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Deep Clean PRO (Dọn rác chuyên sâu đa tầng):" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Quét sạch hơn 20+ ngóc ngách sâu trong Windows: Prefetch, WinSxS Component Store (DISM), Delivery Optimization, Event Logs, GPU Shader Caches (NVIDIA/AMD/Intel), BSOD Minidumps, Cryptnet SSL/TLS Caches, Defender Scan Logs và các tệp cài đặt tạm thời." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Dev &amp; Browser Cache Purge:" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Giải phóng dung lượng từ cache NPM, Yarn, Pip, NuGet, Gradle, Cargo, Composer và bộ nhớ đệm Chrome, Edge, Brave, Cốc Cốc, Firefox, Opera, Vivaldi, Arc." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Performance Turbo &amp; Startup Optimizer:" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tối ưu độ trễ Desktop, tắt giới hạn mạng Gaming (NetworkThrottling 0xFFFFFFFF), tắt dịch vụ thu thập ngầm (DiagTrack, Xbox, Maps) và loại bỏ ứng dụng khởi động thừa (bảo tồn driver OEM/GPU/Audio)." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Fix Windows Update &amp; Win 11 Taskbar Tweaks:" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Sửa lỗi kẹt cập nhật 0x800... bằng cách đặt lại SoftwareDistribution/catroot2 và dọn dẹp các icon thừa trên Taskbar Windows 11 (Searchbox, Widgets, Copilot, Chat)." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 3: MẠNG & SỬA LỖI INTERNET -->
                <Expander x:Name="CardNetwork" Style="{StaticResource ModernExpander}" Tag="NETWORK MANG LAN INTERNET IP FLUSH DNS RENEW DHCP WINSOCK TCP FIREWALL REPAIR ALL">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3. Thông Tin Kết Nối Mạng &amp; Bộ Công Cụ Cứu Hộ Internet (Network Repair)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Thông tin mạng thời gian thực &amp; Chế độ Che IP Riêng Tư (Mask IP):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động nhận diện Card mạng, IP nội bộ (LAN), Router Gateway và IP công cộng (Public IP). Nút '👁️ Che IP' cho phép ẩn giấu các dải IP nhạy cảm (192.168.***.***) chỉ bằng 1 cú click để chống lộ thông tin khi quay màn hình, live stream hoặc chụp ảnh chia sẻ." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 1. Xóa Cache DNS (Flush DNS):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Xóa bộ nhớ đệm phân giải tên miền — sửa triệt để lỗi website không tải được, lỗi đổi IP máy chủ hoặc không vào được mạng dù vẫn kết nối Wi-Fi." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 2. Làm Mới Địa Chỉ IP (DHCP Release &amp; Renew):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Giải phóng và xin cấp lại địa chỉ IP mới từ Router — khắc phục tình trạng xung đột IP, biểu tượng mạng chấm than vàng và mất kết nối LAN." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 3. Đặt Lại TCP/IP &amp; Winsock Catalog (Yêu cầu Admin):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Khôi phục toàn bộ giao thức mạng về mặc định — khắc phục lỗi hỏng Winsock, lỗi nghẽn mạng sau khi gỡ phần mềm VPN/Proxy hoặc diệt virus." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 4. Khôi Phục Windows Firewall Gốc (Yêu cầu Admin):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Xóa toàn bộ các rule chặn mạng rác và đưa tường lửa Windows về cấu hình mặc định an toàn của Microsoft." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 🚀 Khôi Phục Toàn Diện 1-Click (All-in-One Repair):" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động thực hiện tuần tự và tối ưu toàn bộ 4 bước: Xóa Cache DNS ➔ Cấp lại IP ➔ Reset TCP/IP Winsock ➔ Khôi phục Firewall gốc." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• 📡 Quét Thiết Bị Cùng Mạng LAN / Wi-Fi (Who's On My Wi-Fi?):" FontWeight="Bold" Foreground="{DynamicResource AccentSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Quét song song toàn bộ 254 địa chỉ IP trong mạng nội bộ để nhận diện danh sách tất cả các thiết bị đang kết nối Wi-Fi (IP, Địa chỉ MAC, Hostname, Router, Apple/Samsung/TP-Link...) giúp phát hiện tức thì ai đang dùng trộm Wi-Fi." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 4: TIỆN ÍCH & TỰ ĐỘNG -->
                <Expander x:Name="CardUtilities" Style="{StaticResource ModernExpander}" Tag="UTILITIES AUTO CLICK SPAM TEXT PIN LAPTOP BATTERY BLOATWARE CAI APP 7ZIP VSCODE">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="4. Công Cụ Tự Động Hóa &amp; Tiện Ích Đa Năng (Utilities)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Auto Clicker (Click Chuột Tự Động):" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cho phép cấu hình tọa độ X, Y chính xác, số lần click và khoảng cách độ trễ (delay ms). Hỗ trợ nút 'Lấy vị trí chuột (Sau 3s)' để bạn rê chuột đến vị trí mong muốn mà không cần nhớ số tọa độ." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Spam Text &amp; Tự Động Paste Hàng Loạt:" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động nhập nội dung văn bản liên tục hoặc paste từng dòng danh sách có độ trễ, phục vụ nhập liệu tự động trong công việc. Bấm ESC hoặc F6 để ngắt ngay lập tức." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Chẩn đoán Sức Khỏe Pin Laptop &amp; Chu Kỳ Sạc:" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Đo chính xác dung lượng pin gốc (Design Capacity), dung lượng thực tế tối đa (Full Charge Capacity), phần trăm chai pin và số lần cắm sạc (Cycle Count). Có thể bấm 'Báo cáo HTML' để xem biểu đồ chi tiết từ Windows." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Gỡ Bloatware &amp; Cài Đặt Ứng Dụng Phân Loại (Winget 1-Click):" FontWeight="SemiBold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,4"/>
                        <TextBlock Text="Gỡ bỏ các ứng dụng rác mặc định của Windows (Candy Crush, Xbox thừa, Cortana...) và cài đặt một chạm hàng chục phần mềm phổ biến phân loại theo nhóm: Trình duyệt &amp; Chat (Chrome, Brave, Zalo, Telegram, Discord), Dev Tools (VS Code, Git, Node.js, Python, Docker, Postman), Tiện ích hệ thống (7-Zip, WinRAR, UniKey, Everything, Revo) và Giải trí (VLC, Spotify, OBS Studio) qua Microsoft Winget an toàn." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 5: TRUNG TÂM XỬ LÝ MEDIA -->
                <Expander x:Name="CardMedia" Style="{StaticResource ModernExpander}" Tag="MEDIA FFMPEG MP3 AAC WAV FLAC GIF MUTE TAT TIENG TRICH XUAT AM THANH ANH NEN LAM NET H264 PNG MP4 CONVERT DOI DUOI TEP">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="5. Studio Xử Lý Media Đa Năng (Nén, Làm Nét, Đổi Đuôi, Tách Audio, Mute, GIF)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Tự động dò tìm FFmpeg thông minh:" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Hệ thống tự động quét tìm công cụ ffmpeg.exe trong Cli_mediaEXE, thư mục ứng dụng hiện tại, các thư mục mẹ cùng cấp và biến môi trường PATH. Bạn cũng có thể bấm 'Chọn FFmpeg...' để chỉ định tệp thủ công." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Thuật toán Làm Nét Native C# &amp; Video HQ:" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Xử lý trực tiếp trên RAM siêu tốc (~0.1s): Khử gai hạt vi mô (Anti-Grain), Soft-Coring USM thích ứng cạnh, chống quầng sáng/tối viền (Halo suppression) và nổi khối 3D S-Curve mượt mà." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Nén Ảnh &amp; Video hàng loạt (Mặc định giảm ~40% dung lượng):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tự động nhận diện Ảnh hoặc Video: Video được nén bằng thuật toán H.264/AAC với CRF 28 tối ưu, Ảnh được tối ưu hóa theo định dạng (JPG, PNG, WebP). Giảm 40% dung lượng tệp mà mắt thường gần như không nhận ra sự suy giảm độ nét." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Đổi đuôi tệp hàng loạt (Tự động nhận diện Ảnh ➔ .png | Video ➔ .mp4):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Khi thêm file vào danh sách, bạn có thể chọn định dạng đích trực tiếp trên từng dòng của bảng (hỗ trợ .png, .jpg, .webp, .mp4, .mkv, .avi, .mov, .webm...)." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Trích xuất Âm thanh từ Video (Extract Audio ➔ MP3 / AAC / WAV / FLAC / M4A):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Tách riêng track âm thanh chất lượng cao từ hàng loạt video cùng lúc với bitrate tối đa (MP3 320kbps, AAC 256kbps hoặc WAV/FLAC Lossless nguyên bản)." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Tắt tiếng Video siêu tốc (Mute / Stream Copy 0.1s):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Loại bỏ hoàn toàn âm thanh rác/tiếng ồn khỏi video bằng cơ chế Stream Copy, xử lý tức thì chỉ trong vài phần trăm giây và giữ nguyên 100% chất lượng hình ảnh gốc." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Tạo ảnh động GIF chất lượng cao (Video ➔ HD Palette GIF):" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,4"/>
                        <TextBlock Text="Chuyển đổi video ngắn thành ảnh GIF động với bộ lọc Two-pass Palettegen 256 màu tối ưu, đảm bảo chuyển động mượt mà và không bị vỡ hạt dithering." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- MỤC 6: PHÍM TẮT & THAO TÁC TIỆN ÍCH -->
                <Expander x:Name="CardHotkeys" Style="{StaticResource ModernExpander}" Tag="HOTKEYS PHIM TAT ESC F6 TERMINAL LOG CONSOLE THEME DARK LIGHT SANG TOI">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌨️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="6. Phím Tắt Khẩn Cấp, Console Log &amp; Đổi Giao Diện Sáng/Tối" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="• Phím tắt Ngắt Khẩn Cấp (ESC hoặc F6):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Trong quá trình Auto Click, Spam Text hoặc render FFmpeg hàng loạt, bạn có thể nhấn phím ESC hoặc F6 bất kỳ lúc nào để hủy tác vụ ngay lập tức, ngăn ngừa thao tác nhầm lẫn." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Console Log Thời Gian Thực (Realtime Terminal):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Khung log phía dưới ghi lại chi tiết từng dòng lệnh CMD, kết quả thực thi và thông báo lỗi. Bạn có thể kéo thả thanh Splitter để tăng giảm chiều cao khung log, bấm 'Copy Log' để lấy toàn bộ log vào clipboard hoặc 'Xóa Log' khi cần dọn sạch." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,8"/>

                        <TextBlock Text="• Đổi Giao Diện Sáng / Tối (Light / Dark Mode):" FontWeight="SemiBold" Foreground="{DynamicResource AccentDanger}" Margin="0,0,0,4"/>
                        <TextBlock Text="Bấm nút chuyển đổi ở góc dưới bên trái Sidebar (có icon 🌙 / ☀️). Hệ thống sẽ chuyển đổi toàn bộ bảng màu của ứng dụng và khung log theo thời gian thực mà không làm gián đoạn tác vụ đang thực hiện." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- THÔNG BÁO KHI TÌM KIẾM KHÔNG RA KẾT QUẢ -->
                <Border x:Name="PnlNoResults" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Không tìm thấy mục hướng dẫn phù hợp" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hãy thử tìm bằng từ khóa khác hoặc bấm nút 'Tất Cả' để hiển thị lại toàn bộ tài liệu." FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
