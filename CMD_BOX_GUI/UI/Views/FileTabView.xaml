<UserControl x:Class="CMD_BOX_GUI.UI.Views.FileTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0. File Info & Quick Action Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Viewer / Editor Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Toolbar Thông tin File & Thao tác nhanh -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Path & Metadata -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtFileIcon" Text="📄" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtFileName" Text="Untitled.txt" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <Border Background="{DynamicResource BgInput}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFileMeta" Text="Text • 0 B" FontSize="10.5" Foreground="{DynamicResource AccentCyan}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtFilePath" Text="Bản nháp tạm thời (Chưa lưu)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="520" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunScript" Content="▶ Chạy Script" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnRunScript_Click" ToolTip="Thực thi nhanh kịch bản này và in kết quả xuống Terminal"/>
                    <Button x:Name="BtnSendToMedia" Content="🎬 Đưa vào Xử Lý Media" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnSendToMedia_Click" ToolTip="Chuyển tệp Ảnh/Video này sang công cụ Xử Lý Media"/>
                    <Button x:Name="BtnSaveFile" Content="💾 Lưu" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnSaveFile_Click" ToolTip="Lưu nội dung tệp"/>
                    <Button x:Name="BtnCopyText" Content="📋 Copy" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" Click="BtnCopyText_Click" ToolTip="Sao chép nội dung văn bản"/>
                    <Button x:Name="BtnOpenExplorer" Content="📁 Mở Thư Mục" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="11" Visibility="Collapsed" Click="BtnOpenExplorer_Click" ToolTip="Mở vị trí tệp trong Windows Explorer"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1.1 Chế độ Text / Code / Log / Script Editor -->
        <Border x:Name="PnlTextEditor" Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0" Visibility="Visible">
            <TextBox x:Name="TxtEditor"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}"
                     CaretBrush="{DynamicResource AccentCyan}"
                     BorderThickness="0"
                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                     FontSize="12.5"
                     Padding="12,10"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 1.2 Chế độ Xem Trước Ảnh (Image Preview) -->
        <Border x:Name="PnlImagePreview" Grid.Row="1" Style="{StaticResource CardPanel}" Padding="12" Visibility="Collapsed">
            <Grid>
                <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <!-- 1.3 Chế độ Tệp Media / Nhị Phân (Binary / Video Summary) -->
        <Border x:Name="PnlBinaryInfo" Grid.Row="1" Style="{StaticResource CardPanel}" Padding="24" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <TextBlock x:Name="TxtBinaryBigIcon" Text="🎬" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtBinaryTitle" Text="Tệp Đa Phương Tiện / Nhị Phân" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtBinaryDesc" Text="Tệp này không phải văn bản thuần túy. Bạn có thể mở bằng ứng dụng mặc định của Windows hoặc chuyển sang công cụ Xử Lý Media." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnOpenDefaultApp" Content="🚀 Mở Bằng App Mặc Định" Style="{StaticResource PrimaryButton}" Padding="14,7" FontSize="11.5" Margin="0,0,8,0" Click="BtnOpenDefaultApp_Click"/>
                    <Button Content="📁 Hiện Trong Thư Mục" Style="{StaticResource SecondaryButton}" Padding="12,7" FontSize="11.5" Click="BtnOpenExplorer_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>