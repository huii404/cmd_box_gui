<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VS Code Theme Palette (Default Dark+) -->
    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="BgPrimary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#252526"/>
    <SolidColorBrush x:Key="ActivityBarBg" Color="#333333"/>
    <SolidColorBrush x:Key="ActivityBarFg" Color="#858585"/>
    <SolidColorBrush x:Key="ActivityBarActiveFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ActivityBarActiveBorder" Color="#007ACC"/>

    <!-- Editor Tabs & Breadcrumbs -->
    <SolidColorBrush x:Key="EditorTabBg" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="EditorTabActiveBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="EditorTabBorder" Color="#252526"/>
    <SolidColorBrush x:Key="BreadcrumbsBg" Color="#1E1E1E"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBg" Color="#007ACC"/>
    <SolidColorBrush x:Key="StatusBarFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBarSubtle" Color="#005A9E"/>

    <!-- Cards & Panels -->
    <SolidColorBrush x:Key="BgCard" Color="#252526"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="BgInput" Color="#3C3C3C"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="BorderActive" Color="#007ACC"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#969696"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6A737D"/>

    <!-- VS Code Accents -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#0E639C"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="#1177BB"/>
    <SolidColorBrush x:Key="AccentSuccess" Color="#89D185"/>
    <SolidColorBrush x:Key="AccentWarning" Color="#CCA700"/>
    <SolidColorBrush x:Key="AccentDanger" Color="#F14C4C"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#4FC1FF"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#C586C0"/>

    <!-- Integrated Terminal -->
    <SolidColorBrush x:Key="TerminalBg" Color="#181818"/>
    <SolidColorBrush x:Key="TerminalText" Color="#4EC9B0"/>

</ResourceDictionary>
