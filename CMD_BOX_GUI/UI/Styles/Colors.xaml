<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bảng màu Flat Dark Slate hiện đại, nhẹ render -->
    <SolidColorBrush x:Key="BgPrimary" Color="#0B0F19"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#111827"/>
    <SolidColorBrush x:Key="BgCard" Color="#1F2937"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#283548"/>
    <SolidColorBrush x:Key="BgInput" Color="#151E2E"/>

    <SolidColorBrush x:Key="BorderSubtle" Color="#374151"/>
    <SolidColorBrush x:Key="BorderActive" Color="#4B5563"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

    <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentDanger" Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>

    <SolidColorBrush x:Key="TerminalBg" Color="#030712"/>
    <SolidColorBrush x:Key="TerminalText" Color="#10B981"/>

</ResourceDictionary>
